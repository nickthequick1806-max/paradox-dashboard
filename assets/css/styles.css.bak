height:150px;border:1px solid #263c34;border-radius:10px;background:repeating-linear-gradient(to bottom,#08110e 0,#08110e 29px,#17251f 30px);padding:15px}.bars{height:100%;display:flex;align-items:flex-end;gap:6px}.bars i{flex:1;background:linear-gradient(to top,#11a96e,var(--accent));border-radius:3px 3px 0 0;opacity:.8}.rule-breakdown{padding:10px;border:1px solid #263b34;border-radius:10px}.rule-breakdown h3{margin:0 0 8px}.rule-breakdown>div{display:grid;grid-template-columns:1fr 35px 120px;gap:7px;align-items:center;font-size:8px;padding:5px 0}.rule-breakdown i{height:4px;background:var(--accent);display:block}.detection-review-grid{display:grid;grid-template-columns:1.45fr .7fr;gap:10px}.detection-review-grid>section,.detection-review-grid>aside{padding:11px;border:1px solid #263c34;border-radius:10px;background:#07100d}.det-action-banner{display:grid;grid-template-columns:35px 1fr auto;align-items:center;gap:8px;padding:9px;border-radius:9px;background:#27170b;border:1px solid #67451b;color:#ffc34b}.det-action-banner i{font-size:18px}.det-action-banner span{display:block;font-size:7px}.det-action-banner strong{font-size:11px}.det-reason{padding:10px;border:1px solid #402f24;border-radius:8px;background:#100c09;color:#d8c8ba}.det-player{display:flex;align-items:center;gap:8px;margin-bottom:8px}.det-player .avatar{width:35px;height:35px}.removed-audit{display:grid;gap:9px}.removed-stamp{justify-self:start;padding:7px 10px;border:1px solid #7b2b31;border-radius:7px;background:#281114;color:#ff646c;font-weight:900;letter-spacing:.1em}.removed-audit section{padding:10px;border:1px solid #273c34;border-radius:9px;background:#07100d}.removed-audit h3{margin:0 0 4px;font-size:9px}.removed-audit p{margin:0;color:#81928b;font-size:8px}.replay-player{border:1px solid #273e35;border-radius:10px;background:#050b09;overflow:hidden}.replay-screen{height:205px;display:flex;flex-direction:column;gap:7px;align-items:center;justify-content:center;color:#475c54}.replay-screen i{