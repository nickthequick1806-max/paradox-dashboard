:root{
  --bg:#06100e;
  --bg-2:#081411;
  --panel:#0b1715;
  --panel-2:#0f1d1a;
  --panel-3:#12231f;
  --line:#1a302b;
  --line-soft:rgba(129,176,162,.12);
  --text:#f2f7f5;
  --muted:#8fa39d;
  --muted-2:#5f746e;
  --accent:#47f3b4;
  --accent-rgb:71,243,180;
  --accent-2:#22ce91;
  --accent-soft:rgba(var(--accent-rgb),.12);
  --accent-faint:rgba(var(--accent-rgb),.06);
  --red:#ff5d6c;
  --orange:#ffaf44;
  --blue:#4fb8ff;
  --purple:#aa7dff;
  --cyan:#3ce2f2;
  --shadow:0 18px 50px rgba(0,0,0,.28);
  --radius:16px;
  --radius-sm:11px;
  --sidebar:252px;
  --rail:318px;
  --topbar:70px;
  --ease:cubic-bezier(.2,.8,.2,1);
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  color:var(--text);
  background:
    radial-gradient(circle at 68% -10%, rgba(var(--accent-rgb),.08), transparent 28%),
    linear-gradient(180deg,#06100e 0%,#050b0a 100%);
  font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  overflow:hidden;
  letter-spacing:-.01em;
}
button,input,select,textarea{font:inherit;color:inherit}
button{border:0}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:2px solid rgba(var(--accent-rgb),.55);outline-offset:2px}
::selection{background:rgba(var(--accent-rgb),.2)}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#18312a;border-radius:999px;border:2px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-thumb:hover{background:#235042;background-clip:padding-box}

.app-shell{height:100vh;display:grid;grid-template-columns:var(--sidebar) minmax(0,1fr) var(--rail);grid-template-rows:var(--topbar) minmax(0,1fr);grid-template-areas:"sidebar topbar topbar" "sidebar main rail";position:relative}
.sidebar{grid-area:sidebar;background:linear-gradient(180deg,rgba(8,17,15,.99),rgba(6,13,12,.99));border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0;z-index:40}
.brand-row{height:var(--topbar);display:flex;align-items:center;gap:10px;padding:0 17px;border-bottom:1px solid var(--line)}
.brand-logo{width:31px;height:31px;filter:drop-shadow(0 0 12px rgba(var(--accent-rgb),.22))}
.brand-text{font-size:15px;font-weight:800;white-space:nowrap;letter-spacing:.02em}.brand-text span{color:var(--accent)}
.sidebar-close{display:none;margin-left:auto}
.nav-scroll{padding:14px 10px 22px;overflow:auto;min-height:0;flex:1}
.nav-section{margin-bottom:16px}
.nav-label{width:100%;display:flex;align-items:center;justify-content:space-between;background:none;color:#72857f;text-transform:uppercase;font-size:10px;font-weight:800;letter-spacing:.12em;padding:0 10px 7px;text-align:left}
.nav-section-toggle{cursor:pointer}.nav-section-toggle span{transition:.2s var(--ease)}.collapsible:not(.open) .nav-section-toggle span{transform:rotate(180deg)}
.nav-section-body{display:grid;grid-template-rows:1fr;overflow:hidden}.collapsible:not(.open) .nav-section-body{display:none}
.nav-item{width:100%;height:35px;padding:0 10px;border-radius:9px;background:transparent;color:#91a19d;display:flex;align-items:center;gap:11px;cursor:pointer;transition:.16s var(--ease);font-size:12px;position:relative;text-align:left}
.nav-item:hover{color:#d9e5e1;background:rgba(255,255,255,.025)}
.nav-item.active{color:var(--accent);background:linear-gradient(90deg,rgba(var(--accent-rgb),.15),rgba(var(--accent-rgb),.06));box-shadow:inset 0 0 0 1px rgba(var(--accent-rgb),.05)}
.nav-item.active::before{content:"";position:absolute;right:0;top:8px;bottom:8px;width:2px;border-radius:5px;background:var(--accent);box-shadow:0 0 12px rgba(var(--accent-rgb),.55)}
.nav-icon{width:16px;text-align:center;color:#83a09a;font-size:14px}.nav-item.active .nav-icon{color:var(--accent)}
.nav-chev{margin-left:auto;font-size:17px}
.sidebar-foot{padding:12px;border-top:1px solid var(--line)}
.health-pill{border:1px solid var(--line);background:rgba(255,255,255,.018);border-radius:11px;padding:10px 11px;display:flex;gap:8px;align-items:center;color:#9caeaa;font-size:10px}.health-pill strong{margin-left:auto;color:var(--accent);font-size:10px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--accent);display:inline-block;box-shadow:0 0 12px rgba(var(--accent-rgb),.7)}
.pulse{animation:pulse 2s infinite}@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(var(--accent-rgb),.36)}50%{box-shadow:0 0 0 7px rgba(var(--accent-rgb),0)}}

.topbar{grid-area:topbar;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 16px;gap:13px;background:rgba(5,13,11,.82);backdrop-filter:blur(18px);z-index:30}
.menu-btn{display:none}
.search-wrap{width:min(440px,42vw);height:38px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.02);display:flex;align-items:center;padding:0 10px;gap:9px;color:#80938e;cursor:pointer;transition:.18s var(--ease)}
.search-wrap:hover{border-color:#2d5449;background:rgba(255,255,255,.03)}
.search-placeholder{font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.search-icon{font-size:16px;color:#a7b5b1}.search-wrap kbd{margin-left:auto;border:1px solid #263a35;border-radius:5px;padding:3px 6px;color:#7e908b;background:#0b1513;font-size:9px}
.topbar-spacer{flex:1}
.top-link{background:none;color:#9caeaa;display:flex;align-items:center;gap:7px;font-size:11px;cursor:pointer;padding:8px;border-radius:8px}.top-link:hover{background:rgba(255,255,255,.03);color:#d6e0dd}
.icon-btn{width:34px;height:34px;border-radius:9px;background:transparent;color:#93a7a2;display:grid;place-items:center;cursor:pointer;font-size:16px;transition:.17s var(--ease)}.icon-btn:hover{background:rgba(255,255,255,.045);color:white}
.notification-btn{position:relative}.notification-dot{position:absolute;top:7px;right:7px;width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent)}
.profile{height:44px;display:flex;align-items:center;gap:10px;padding:0 6px 0 8px;border-left:1px solid var(--line);cursor:pointer;min-width:185px}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#12493e,#0c2f29);border:1px solid #1f6657;color:#d5fff1;font-weight:700}.profile-copy{display:flex;flex-direction:column;font-size:10px;color:#81938f}.profile-copy strong{font-size:12px;color:#edf4f2;font-weight:650}.profile .chev{margin-left:auto;color:#6e817c}

.main{grid-area:main;overflow:auto;padding:18px;min-width:0;scroll-behavior:smooth}
.right-rail{grid-area:rail;border-left:1px solid var(--line);background:#06100e;padding:12px;overflow:auto}.right-rail.hidden{display:none}.app-shell.no-rail{grid-template-columns:var(--sidebar) minmax(0,1fr);grid-template-areas:"sidebar topbar" "sidebar main"}.app-shell.no-rail .right-rail{display:none}

.page{animation:pageIn .28s var(--ease)}@keyframes pageIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:15px}.page-head h1{font-size:21px;margin:0 0 4px;letter-spacing:-.025em}.page-head p{margin:0;color:var(--muted);font-size:11px;line-height:1.55}.page-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.btn{height:34px;padding:0 12px;border-radius:9px;border:1px solid var(--line);background:#0c1715;color:#c8d6d2;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;font-size:10.5px;font-weight:650;transition:.18s var(--ease);white-space:nowrap}.btn:hover{transform:translateY(-1px);border-color:#315a4f;background:#10201c}.btn.primary{border-color:rgba(var(--accent-rgb),.35);background:linear-gradient(180deg,rgba(var(--accent-rgb),.18),rgba(var(--accent-rgb),.09));color:#a9ffdc}.btn.danger{border-color:rgba(255,93,108,.24);color:#ff9ba5;background:rgba(255,93,108,.06)}.btn.ghost{background:transparent}.btn.icon-only{width:34px;padding:0}

.panel{border:1px solid var(--line);background:linear-gradient(180deg,rgba(12,24,21,.96),rgba(8,17,15,.96));border-radius:var(--radius);box-shadow:0 1px 0 rgba(255,255,255,.015);overflow:hidden}.panel-head{display:flex;align-items:center;gap:11px;padding:14px 15px;border-bottom:1px solid var(--line-soft)}.panel-head.no-border{border-bottom:0}.panel-title{font-size:12px;font-weight:700}.panel-subtitle{font-size:10px;color:var(--muted);margin-top:3px}.panel-icon{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);font-weight:900}.panel-spacer{flex:1}.panel-body{padding:15px}.panel-foot{padding:12px 15px;border-top:1px solid var(--line-soft);color:var(--muted);font-size:10px}

.hero{min-height:178px;border:1px solid rgba(var(--accent-rgb),.33);border-radius:15px;position:relative;overflow:hidden;background:
  linear-gradient(90deg,rgba(5,15,12,.95) 0%,rgba(6,18,15,.78) 45%,rgba(5,15,12,.85) 100%),
  radial-gradient(circle at 25% 20%,rgba(var(--accent-rgb),.16),transparent 30%),
  linear-gradient(135deg,#0b211b,#07100e 65%);box-shadow:inset 0 0 40px rgba(var(--accent-rgb),.03),0 10px 45px rgba(0,0,0,.18);display:flex;align-items:center;padding:20px 22px;margin-bottom:14px}
.hero::before{content:"";position:absolute;inset:0;opacity:.16;background-image:linear-gradient(rgba(var(--accent-rgb),.14) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--accent-rgb),.10) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to right,black,transparent 80%)}
.hero::after{content:"";position:absolute;left:36%;right:8%;bottom:0;height:75%;opacity:.23;background:linear-gradient(to top,#173a32,transparent),repeating-linear-gradient(90deg,transparent 0 20px,rgba(122,190,170,.12) 20px 24px,transparent 24px 44px);clip-path:polygon(0 100%,0 58%,4% 58%,4% 39%,8% 39%,8% 65%,13% 65%,13% 25%,17% 25%,17% 53%,22% 53%,22% 34%,28% 34%,28% 68%,34% 68%,34% 18%,38% 18%,38% 51%,44% 51%,44% 31%,48% 31%,48% 62%,55% 62%,55% 10%,60% 10%,60% 45%,66% 45%,66% 27%,70% 27%,70% 57%,77% 57%,77% 21%,82% 21%,82% 48%,88% 48%,88% 33%,94% 33%,94% 66%,100% 66%,100% 100%)}
.hero-content{position:relative;z-index:2;display:flex;align-items:center;gap:18px;width:100%}.hero-logo{width:76px;height:76px;filter:drop-shadow(0 0 18px rgba(var(--accent-rgb),.26))}.hero-copy{min-width:0}.status-tag{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:999px;background:rgba(var(--accent-rgb),.09);border:1px solid rgba(var(--accent-rgb),.14);color:var(--accent);font-size:9px;font-weight:800;letter-spacing:.06em;margin-bottom:9px}.hero h2{font-size:30px;line-height:1;margin:0 0 10px;letter-spacing:-.035em}.hero-meta{font-size:11px;color:#c1d0cc;display:flex;gap:9px;flex-wrap:wrap}.hero-meta span+span::before{content:"•";margin-right:9px;color:var(--accent)}.hero-caption{margin-top:11px;font-size:10px;color:#859993}.hero-caption strong{color:var(--accent)}.hero-action{margin-left:auto;align-self:flex-start}

.stats-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:14px}.stat-card{border:1px solid var(--line);background:linear-gradient(180deg,#0c1715,#091310);border-radius:12px;padding:13px;min-width:0;position:relative;overflow:hidden;transition:.2s var(--ease)}.stat-card::after{content:"";position:absolute;inset:auto -20px -30px auto;width:70px;height:70px;border-radius:50%;background:radial-gradient(circle,var(--card-glow,rgba(var(--accent-rgb),.13)),transparent 70%)}.stat-card:hover{transform:translateY(-2px);border-color:#2a4c43}.stat-top{display:flex;align-items:center;gap:8px;color:#849892;font-size:9px;text-transform:uppercase;font-weight:750;letter-spacing:.06em}.stat-icon{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:var(--card-soft,rgba(var(--accent-rgb),.10));color:var(--card-color,var(--accent));font-size:16px}.stat-value-row{display:flex;align-items:baseline;gap:7px;margin:6px 0 5px}.stat-value{font-size:21px;font-weight:750;letter-spacing:-.04em}.delta{font-size:9px;color:var(--accent)}.delta.down{color:#68dfa8}.delta.bad{color:var(--red)}.stat-note{font-size:9px;color:#6f837e}

.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(290px,.85fr);gap:12px}.span-2{grid-column:1/-1}.chart-panel{min-height:292px}.chart-head-actions{display:flex;gap:5px}.range-btn{height:29px;min-width:38px;border-radius:7px;border:1px solid var(--line);background:#081210;color:#7f928d;font-size:9px;cursor:pointer}.range-btn.active,.range-btn:hover{border-color:rgba(var(--accent-rgb),.33);background:rgba(var(--accent-rgb),.07);color:var(--accent)}
.chart-legend{display:flex;gap:16px;padding:1px 16px 4px;color:#91a39e;font-size:9px;flex-wrap:wrap}.legend-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:5px}.chart-wrap{height:210px;padding:0 12px 10px}.chart-wrap canvas{width:100%;height:100%;display:block}
.health-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:12px 0}.health-card{border:1px solid var(--line);border-radius:12px;background:#0a1512;padding:12px;display:grid;grid-template-columns:38px 1fr;gap:10px}.health-card .h-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);font-size:18px}.health-card small{display:block;color:#7f938d;text-transform:uppercase;font-size:8.5px;font-weight:700;letter-spacing:.07em}.health-card strong{display:block;margin-top:4px;font-size:16px}.meter{height:4px;background:#172923;border-radius:999px;margin-top:8px;overflow:hidden}.meter span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent-2),var(--accent));box-shadow:0 0 10px rgba(var(--accent-rgb),.25)}

.table-wrap{overflow:auto}.data-table{width:100%;border-collapse:collapse;min-width:760px}.data-table th{font-size:8.5px;text-transform:uppercase;letter-spacing:.08em;color:#6d817b;text-align:left;padding:10px 12px;border-bottom:1px solid var(--line-soft);font-weight:750;white-space:nowrap}.data-table td{padding:11px 12px;border-bottom:1px solid rgba(126,166,155,.08);font-size:10px;color:#b7c6c2;white-space:nowrap}.data-table tr:hover td{background:rgba(255,255,255,.015)}.data-table tbody tr:last-child td{border-bottom:0}.cell-main{font-weight:650;color:#eef5f3}.cell-sub{display:block;color:#70847e;font-size:9px;margin-top:2px}.mono{font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:9.5px}.status-chip,.risk-chip,.tag{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;font-size:8.5px;font-weight:750;border:1px solid transparent}.status-chip.good,.risk-chip.low,.tag.green{color:#75f0ba;background:rgba(var(--accent-rgb),.09);border-color:rgba(var(--accent-rgb),.12)}.status-chip.warn,.risk-chip.medium,.tag.orange{color:#ffc56f;background:rgba(255,175,68,.09);border-color:rgba(255,175,68,.12)}.status-chip.bad,.risk-chip.high,.tag.red{color:#ff8b97;background:rgba(255,93,108,.09);border-color:rgba(255,93,108,.12)}.tag.blue{color:#78c9ff;background:rgba(79,184,255,.09);border-color:rgba(79,184,255,.12)}.tag.purple{color:#c8acff;background:rgba(170,125,255,.09);border-color:rgba(170,125,255,.12)}
.table-actions{display:flex;gap:5px}.mini-btn{width:28px;height:28px;border-radius:7px;border:1px solid var(--line);background:#0a1412;color:#8da09a;display:grid;place-items:center;cursor:pointer}.mini-btn:hover{color:var(--accent);border-color:#2d5549;background:#0d1b17}

.event-list{display:flex;flex-direction:column}.event-row{display:grid;grid-template-columns:34px 1.5fr 1.15fr 90px 72px;gap:9px;align-items:center;padding:10px 13px;border-top:1px solid rgba(128,170,159,.08)}.event-row:first-child{border-top:0}.event-icon{width:28px;height:28px;border-radius:8px;display:grid;place-items:center}.event-icon.red{background:rgba(255,93,108,.10);color:var(--red)}.event-icon.orange{background:rgba(255,175,68,.10);color:var(--orange)}.event-icon.green{background:rgba(var(--accent-rgb),.10);color:var(--accent)}.event-main strong{display:block;font-size:10px}.event-main span,.event-player{font-size:9px;color:#7d908b}.event-time{font-size:9px;color:#82958f;text-align:right}
.top-detections{padding:6px 14px 14px}.rank-row{display:grid;grid-template-columns:22px 1fr minmax(80px,130px) 25px;gap:8px;align-items:center;padding:7px 0}.rank-badge{width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:rgba(255,93,108,.12);color:#ff7e8a;font-size:8px}.rank-row:nth-child(2) .rank-badge{background:rgba(255,175,68,.12);color:var(--orange)}.rank-row:nth-child(3) .rank-badge{background:rgba(79,184,255,.12);color:var(--blue)}.rank-name{font-size:9.5px}.rank-bar{height:4px;border-radius:9px;background:#1a2b27;overflow:hidden}.rank-bar span{display:block;height:100%;background:linear-gradient(90deg,#ff7b75,#ff4e70);border-radius:inherit}.rank-row:nth-child(2) .rank-bar span{background:linear-gradient(90deg,#ffc85b,#ff8c3f)}.rank-row:nth-child(3) .rank-bar span{background:linear-gradient(90deg,#67d7ff,#3e94ff)}.rank-value{font-size:9px;color:#b8c7c3;text-align:right}

.rail-section{border:1px solid var(--line);border-radius:13px;background:linear-gradient(180deg,#0b1715,#081210);overflow:hidden;margin-bottom:10px}.rail-head{display:flex;align-items:center;gap:8px;padding:12px 13px;border-bottom:1px solid var(--line-soft);font-size:11px;font-weight:700}.rail-head span:first-child{color:var(--accent)}.control-row{display:grid;grid-template-columns:30px 1fr auto;gap:9px;padding:12px;border-top:1px solid rgba(128,170,159,.08);align-items:start}.control-row:first-child{border-top:0}.control-icon{width:30px;height:30px;display:grid;place-items:center;color:var(--cyan);font-size:15px}.control-copy strong{display:block;font-size:10px;margin:1px 0 4px}.control-copy span{font-size:9px;line-height:1.45;color:#778b85;display:block}.switch{width:34px;height:19px;border-radius:999px;background:#293932;border:1px solid #344a43;padding:2px;cursor:pointer;transition:.2s var(--ease);position:relative}.switch::before{content:"";position:absolute;width:13px;height:13px;left:2px;top:2px;border-radius:50%;background:#c6d1ce;transition:.2s var(--ease)}.switch.on{background:rgba(var(--accent-rgb),.19);border-color:rgba(var(--accent-rgb),.32)}.switch.on::before{left:17px;background:var(--accent);box-shadow:0 0 9px rgba(var(--accent-rgb),.45)}
.quick-row{height:38px;padding:0 13px;display:flex;align-items:center;gap:9px;border-top:1px solid rgba(128,170,159,.08);font-size:10px;color:#9eb0ab;cursor:pointer}.quick-row:hover{background:rgba(255,255,255,.02);color:#e4ecea}.quick-row .qicon{width:18px;text-align:center;color:#99aaa6}.quick-row .arrow{margin-left:auto}.server-card{padding:12px}.server-ident{display:flex;align-items:center;gap:9px;margin-bottom:10px}.server-ident .server-icon{width:32px;height:32px;border-radius:9px;background:rgba(79,184,255,.13);display:grid;place-items:center;color:var(--blue)}.server-ident strong{font-size:10px;display:block}.server-ident span{font-size:9px;color:#748781}.kv{display:flex;justify-content:space-between;gap:12px;font-size:9px;padding:3px 0;color:#78908a}.kv strong{font-weight:600;color:#b6c7c2}.quote-card{padding:16px 12px;text-align:center;color:#9dafaa;font-size:10px;letter-spacing:.08em}.quote-card img{width:44px;display:block;margin:0 auto 8px}.quote-card strong{display:block;color:#dce7e4;font-weight:650}

.filters{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.input,.select,.textarea{border:1px solid var(--line);background:#081310;border-radius:9px;color:#c8d5d2;font-size:10px;transition:.15s var(--ease)}.input{height:34px;padding:0 10px}.input::placeholder{color:#5f746e}.input:focus,.select:focus,.textarea:focus{border-color:#2d5d50;box-shadow:0 0 0 3px rgba(var(--accent-rgb),.05)}.select{height:34px;padding:0 30px 0 10px}.textarea{width:100%;min-height:110px;padding:10px;resize:vertical}.filters .input.search{min-width:230px}.filters .spacer{flex:1}

.config-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.config-card{border:1px solid var(--line);border-radius:13px;background:#0a1512;padding:14px}.config-card h3{font-size:12px;margin:0 0 4px}.config-card>p{font-size:9.5px;color:#71857f;line-height:1.5;margin:0 0 14px}.setting-row{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;padding:11px 0;border-top:1px solid rgba(128,170,159,.08)}.setting-copy strong{display:block;font-size:10px}.setting-copy span{display:block;color:#6d817b;font-size:9px;margin-top:3px;line-height:1.4}.setting-control{display:flex;align-items:center;gap:7px}.setting-control .input{width:95px}.setting-control .select{width:120px}

.rules-list{display:grid;gap:8px}.rule-row{display:grid;grid-template-columns:auto 1.3fr .9fr .6fr .6fr auto;gap:10px;align-items:center;border:1px solid var(--line-soft);background:#091310;border-radius:11px;padding:10px 11px;transition:.15s var(--ease)}.rule-row:hover{border-color:#294b42;background:#0b1714}.rule-name strong{font-size:10px;display:block}.rule-name span{font-size:8.8px;color:#6e827c;margin-top:3px;display:block}.rule-metric{font-size:9px;color:#81958f}.rule-metric strong{display:block;color:#c7d5d1;font-size:10px;margin-top:2px}.check-box{width:18px;height:18px;border-radius:5px;border:1px solid #2a433c;background:#0b1714;display:grid;place-items:center;color:var(--accent);font-size:10px}.check-box.checked{background:rgba(var(--accent-rgb),.1);border-color:rgba(var(--accent-rgb),.32)}

.console{height:calc(100vh - 145px);min-height:520px;display:flex;flex-direction:column}.console-output{flex:1;background:#050b0a;padding:12px 14px;overflow:auto;font-family:"SFMono-Regular",Consolas,monospace;font-size:10px;line-height:1.75}.console-line{color:#839690}.console-line .time{color:#526861}.console-line .info{color:var(--blue)}.console-line .ok{color:var(--accent)}.console-line .warn{color:var(--orange)}.console-line .err{color:var(--red)}.console-input-row{border-top:1px solid var(--line);padding:10px;background:#081210;display:flex;gap:8px}.console-input-row span{color:var(--accent);font-family:monospace;padding-top:8px}.console-input-row input{flex:1;background:transparent;border:0;outline:0;font-family:monospace;font-size:10px}

.player-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.player-card{border:1px solid var(--line);border-radius:13px;background:#0a1512;padding:12px;transition:.2s var(--ease)}.player-card:hover{transform:translateY(-2px);border-color:#2a5045}.player-card-top{display:flex;gap:10px;align-items:center}.player-avatar{width:42px;height:42px;border-radius:11px;background:linear-gradient(145deg,#163f37,#0c2420);display:grid;place-items:center;font-weight:750;color:#c8f9e8;border:1px solid #24584c}.player-card h3{font-size:11px;margin:0 0 3px}.player-card .meta{font-size:9px;color:#6f837d}.player-card .risk-line{margin-left:auto;text-align:right}.player-card .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:12px}.player-card .mini-metric{background:#08110f;border-radius:8px;padding:8px}.mini-metric span{display:block;font-size:8px;color:#667c75;text-transform:uppercase}.mini-metric strong{font-size:10px;margin-top:3px;display:block}

.map-shell{position:relative;height:calc(100vh - 170px);min-height:560px;border:1px solid var(--line);border-radius:15px;overflow:hidden;background:#071210}.map-canvas{position:absolute;inset:0;background:
radial-gradient(circle at 58% 42%,rgba(var(--accent-rgb),.09),transparent 25%),
linear-gradient(27deg,transparent 46%,rgba(87,128,116,.13) 47% 48%,transparent 49%),
linear-gradient(137deg,transparent 44%,rgba(87,128,116,.12) 45% 46%,transparent 47%),
linear-gradient(90deg,rgba(54,82,74,.11) 1px,transparent 1px),
linear-gradient(rgba(54,82,74,.10) 1px,transparent 1px),#07110f;background-size:auto,auto,auto,40px 40px,40px 40px}.map-canvas::after{content:"";position:absolute;inset:8%;border:1px solid rgba(89,139,125,.12);border-radius:34% 41% 28% 37% / 31% 29% 41% 35%;transform:rotate(-8deg);box-shadow:inset 0 0 90px rgba(var(--accent-rgb),.025)}.map-pin{position:absolute;width:28px;height:28px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--accent);box-shadow:0 0 0 5px rgba(var(--accent-rgb),.08),0 0 20px rgba(var(--accent-rgb),.25);cursor:pointer}.map-pin::after{content:"";position:absolute;inset:8px;border-radius:50%;background:#07110f}.map-pin.red{background:var(--red);box-shadow:0 0 0 5px rgba(255,93,108,.08),0 0 20px rgba(255,93,108,.18)}.map-panel{position:absolute;top:12px;left:12px;width:265px}.map-tools{position:absolute;right:12px;top:12px;display:flex;flex-direction:column;gap:6px}.map-tools .btn{width:36px;padding:0}

.metric-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}.metric-card{border:1px solid var(--line);border-radius:12px;background:#0a1512;padding:13px}.metric-card small{display:block;color:#70847e;text-transform:uppercase;font-size:8.5px;letter-spacing:.07em}.metric-card strong{font-size:19px;display:block;margin:7px 0 3px}.metric-card p{font-size:9px;color:#758982;margin:0}

.empty-state{padding:38px;text-align:center;color:#738780}.empty-state .empty-icon{font-size:30px;color:#30564b;margin-bottom:10px}.empty-state strong{display:block;color:#c5d3cf;font-size:12px;margin-bottom:4px}.empty-state span{font-size:9.5px}

.timeline{position:relative;padding-left:18px}.timeline::before{content:"";position:absolute;left:5px;top:3px;bottom:3px;width:1px;background:#1a332d}.timeline-item{position:relative;padding:0 0 16px 14px}.timeline-item::before{content:"";position:absolute;left:-17px;top:3px;width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px #0a1714}.timeline-item strong{display:block;font-size:10px}.timeline-item span{display:block;font-size:9px;color:#728680;margin-top:3px}.timeline-item time{font-size:8px;color:#50655f;display:block;margin-top:3px}

.code-block{background:#050b0a;border:1px solid #12211d;border-radius:10px;padding:12px;font-family:monospace;font-size:9.5px;color:#95a9a3;white-space:pre-wrap;overflow:auto}.code-block .key{color:#75d5ff}.code-block .val{color:#87f5bd}

.integration-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.integration-card{border:1px solid var(--line);border-radius:13px;background:#0a1512;padding:14px;display:flex;gap:11px;align-items:flex-start}.integration-logo{width:42px;height:42px;border-radius:10px;background:#101f1b;display:grid;place-items:center;font-size:17px;color:var(--accent);border:1px solid #1b342e}.integration-card h3{font-size:11px;margin:0 0 4px}.integration-card p{font-size:9px;color:#70847d;margin:0 0 10px;line-height:1.5}.integration-card .status-chip{margin-left:auto}

.status-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.service-card{border:1px solid var(--line);border-radius:12px;background:#0a1512;padding:13px}.service-top{display:flex;align-items:center;gap:8px}.service-icon{width:31px;height:31px;border-radius:9px;background:var(--accent-soft);display:grid;place-items:center;color:var(--accent)}.service-top strong{font-size:10px}.service-top span{font-size:8.5px;color:#72857f;display:block;margin-top:2px}.service-status{margin-left:auto;color:var(--accent);font-size:9px}.service-card .latency{margin-top:10px;font-size:9px;color:#6f827c;display:flex;justify-content:space-between}

.modal-layer{position:fixed;inset:0;background:rgba(2,7,6,.66);backdrop-filter:blur(8px);z-index:200;display:none;align-items:center;justify-content:center;padding:20px}.modal-layer.open{display:flex;animation:fadeIn .18s var(--ease)}@keyframes fadeIn{from{opacity:0}to{opacity:1}}.modal{width:min(680px,94vw);max-height:88vh;overflow:auto;background:linear-gradient(180deg,#0d1a17,#08110f);border:1px solid #28463e;border-radius:16px;box-shadow:0 25px 80px rgba(0,0,0,.48);animation:modalIn .22s var(--ease)}@keyframes modalIn{from{opacity:0;transform:scale(.97) translateY(5px)}to{opacity:1;transform:none}}.modal-head{padding:14px 15px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}.modal-head h3{margin:0;font-size:13px}.modal-head .close{margin-left:auto}.modal-body{padding:15px}.modal-foot{padding:12px 15px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field label{display:block;font-size:9px;color:#839690;margin-bottom:5px}.field .input,.field .select{width:100%}.field.full{grid-column:1/-1}

.search-modal .modal-body{padding:10px}.search-box-big{height:46px;border:1px solid var(--line);border-radius:11px;background:#08120f;display:flex;align-items:center;gap:10px;padding:0 12px}.search-box-big input{flex:1;border:0;background:transparent;outline:0;font-size:12px}.search-results{margin-top:10px}.search-result{display:flex;align-items:center;gap:10px;padding:10px;border-radius:9px;cursor:pointer}.search-result:hover{background:rgba(255,255,255,.03)}.result-icon{width:31px;height:31px;border-radius:8px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent)}.result-copy strong{font-size:10px;display:block}.result-copy span{font-size:9px;color:#72847f}.result-type{margin-left:auto;font-size:8px;color:#61766f;text-transform:uppercase}

.toast-stack{position:fixed;right:18px;bottom:18px;z-index:300;display:flex;flex-direction:column;gap:8px;pointer-events:none}.toast{min-width:290px;max-width:380px;border:1px solid #29473f;border-radius:11px;background:rgba(10,22,19,.97);box-shadow:var(--shadow);padding:11px 12px;display:flex;gap:9px;align-items:flex-start;animation:toastIn .26s var(--ease);pointer-events:auto}.toast.out{animation:toastOut .2s var(--ease) forwards}@keyframes toastIn{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}@keyframes toastOut{to{opacity:0;transform:translateX(18px)}}.toast-icon{width:27px;height:27px;border-radius:8px;background:var(--accent-soft);display:grid;place-items:center;color:var(--accent)}.toast strong{display:block;font-size:10px}.toast span{display:block;font-size:9px;color:#71857f;margin-top:3px;line-height:1.4}

.mobile-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:35}

@media (max-width:1450px){:root{--rail:290px;--sidebar:232px}.stats-grid{grid-template-columns:repeat(3,1fr)}.profile{min-width:160px}.hero h2{font-size:26px}}
@media (max-width:1180px){.app-shell{grid-template-columns:var(--sidebar) minmax(0,1fr);grid-template-areas:"sidebar topbar" "sidebar main"}.right-rail{display:none}.dashboard-grid{grid-template-columns:1fr}.health-grid{grid-template-columns:repeat(2,1fr)}.integration-grid{grid-template-columns:repeat(2,1fr)}.player-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:860px){body{overflow:auto}.app-shell{display:block;height:auto;min-height:100vh}.topbar{position:sticky;top:0;height:60px}.sidebar{position:fixed;left:0;top:0;bottom:0;width:270px;transform:translateX(-105%);transition:.24s var(--ease);box-shadow:25px 0 60px rgba(0,0,0,.35)}.sidebar.open{transform:none}.sidebar-close,.menu-btn{display:grid}.mobile-overlay.show{display:block}.main{overflow:visible;padding:13px}.search-wrap{width:min(420px,60vw)}.top-link{display:none}.profile{min-width:auto}.profile-copy,.profile .chev{display:none}.stats-grid{grid-template-columns:repeat(2,1fr)}.config-grid,.integration-grid,.status-grid{grid-template-columns:1fr}.player-grid{grid-template-columns:1fr}.page-head{flex-direction:column}.page-actions{justify-content:flex-start}.metric-cards{grid-template-columns:repeat(2,1fr)}.event-row{grid-template-columns:34px 1fr 70px}.event-player,.event-time{display:none}.rule-row{grid-template-columns:auto 1fr auto}.rule-metric{display:none}.hero{padding:17px}.hero-logo{width:58px;height:58px}.hero h2{font-size:23px}.hero-action{display:none}}
@media (max-width:560px){.search-wrap{flex:1;width:auto}.search-wrap kbd{display:none}.profile{display:none}.stats-grid,.metric-cards,.health-grid{grid-template-columns:1fr}.hero-meta{display:none}.hero-caption{max-width:260px}.hero-logo{width:50px;height:50px}.hero h2{font-size:20px}.main{padding:10px}.panel-head{padding:12px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}}


/* ===== PARADOX dashboard v3 interaction + theme overrides ===== */
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;
  background-image:
    linear-gradient(rgba(var(--accent-rgb),.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(var(--accent-rgb),.035) 1px,transparent 1px);
  background-size:44px 44px;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.9),rgba(0,0,0,.32));
}
body{background-color:#050b0a;background-image:radial-gradient(circle at 68% -10%,rgba(var(--accent-rgb),.075),transparent 30%),linear-gradient(180deg,rgba(6,16,14,.96),rgba(4,9,8,.98));}
.sidebar,.right-rail{background:rgba(5,13,11,.88);backdrop-filter:blur(18px)}
.main{background:linear-gradient(180deg,rgba(5,14,12,.38),rgba(4,10,9,.25));}
.topbar{position:relative;justify-content:flex-end;background:rgba(4,12,10,.88)}
.search-wrap{position:absolute;left:50%;transform:translateX(-50%);width:min(520px,38vw);z-index:2}
.topbar-spacer{display:none}
.brand-row{padding-right:14px}
.brand-text span,.health-pill strong,.nav-item.active,.nav-item.active .nav-icon,.panel-icon,.service-icon,.integration-logo,.service-status{color:var(--accent)!important}
.nav-section-toggle span{font-family:"Font Awesome 6 Free";font-weight:900;font-size:9px}
.collapsible .nav-section-toggle span::before{content:"\f077"}.collapsible:not(.open) .nav-section-toggle span::before{content:"\f078"}.nav-section-toggle span{font-size:0}.nav-section-toggle span::before{font-size:9px}
.btn.primary{border-color:rgba(var(--accent-rgb),.34);background:linear-gradient(180deg,rgba(var(--accent-rgb),.18),rgba(var(--accent-rgb),.08));color:var(--accent)}
.status-tag,.tag.green,.status-chip.good{color:var(--accent)}
.avatar{border-color:rgba(var(--accent-rgb),.35);background:linear-gradient(145deg,rgba(var(--accent-rgb),.20),rgba(var(--accent-rgb),.06));color:var(--accent)}
.profile{border-left:1px solid var(--line);border-radius:10px;transition:.18s var(--ease)}
.profile:hover{background:rgba(255,255,255,.028)}
.profile.open{background:rgba(var(--accent-rgb),.06);box-shadow:inset 0 0 0 1px rgba(var(--accent-rgb),.09)}
.top-link i,.notification-btn i{font-size:13px}
.notification-btn{font-size:14px}
.notification-dot{background:var(--accent);box-shadow:0 0 8px var(--accent)}

/* anchored dropdown menus */
.dropdown-layer{position:fixed;inset:0;z-index:170;pointer-events:none}
.dropdown-popover{position:fixed;min-width:260px;max-width:min(380px,calc(100vw - 24px));background:linear-gradient(180deg,rgba(13,27,23,.99),rgba(7,16,14,.99));border:1px solid #29483f;border-radius:13px;box-shadow:0 22px 70px rgba(0,0,0,.48);overflow:hidden;pointer-events:auto;animation:dropIn .18s var(--ease);transform-origin:top right}
@keyframes dropIn{from{opacity:0;transform:translateY(-5px) scale(.985)}to{opacity:1;transform:none}}
.dropdown-head{padding:12px 13px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:9px}.dropdown-head strong{font-size:11px}.dropdown-head span{font-size:9px;color:var(--muted);display:block;margin-top:2px}.dropdown-head .dropdown-badge{margin-left:auto}
.dropdown-menu{padding:6px}
.dropdown-item{width:100%;min-height:38px;display:flex;align-items:center;gap:10px;border-radius:9px;padding:8px 9px;background:transparent;color:#c2cfcb;cursor:pointer;text-align:left;font-size:10.5px;transition:.16s var(--ease)}
.dropdown-item:hover{background:rgba(var(--accent-rgb),.07);color:#fff}.dropdown-item i{width:16px;text-align:center;color:#86a19a}.dropdown-item:hover i{color:var(--accent)}.dropdown-item.danger{color:#ff8d99}.dropdown-item.danger i{color:#ff6e7c}
.dropdown-divider{height:1px;background:var(--line);margin:5px 4px}
.notification-list{max-height:360px;overflow:auto;padding:6px}.notification-card{display:grid;grid-template-columns:32px 1fr auto;gap:9px;padding:9px;border-radius:10px;cursor:pointer;transition:.16s var(--ease)}.notification-card:hover{background:rgba(255,255,255,.028)}.notification-card.unread{background:rgba(var(--accent-rgb),.045)}.notification-card .n-icon{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:rgba(var(--accent-rgb),.1);color:var(--accent)}.notification-card strong{font-size:9.5px;display:block}.notification-card p{font-size:8.5px;color:#748780;margin:3px 0 0;line-height:1.4}.notification-card time{font-size:7.5px;color:#596c66;white-space:nowrap}.notification-empty{padding:26px;text-align:center;color:#72847f;font-size:9px}

/* custom select-like menus */
.custom-dropdown{position:relative;min-width:132px}.custom-dropdown-btn{width:100%;height:33px;border:1px solid var(--line);border-radius:8px;background:#091411;color:#c5d2ce;display:flex;align-items:center;gap:8px;padding:0 10px;cursor:pointer;font-size:9.5px}.custom-dropdown-btn i:last-child{margin-left:auto;color:#61756f;font-size:8px}.custom-dropdown-menu{position:absolute;z-index:80;top:calc(100% + 5px);left:0;right:0;background:#0b1815;border:1px solid #29463f;border-radius:9px;padding:5px;box-shadow:var(--shadow);display:none}.custom-dropdown.open .custom-dropdown-menu{display:block;animation:dropIn .16s var(--ease)}.custom-dropdown-option{width:100%;padding:7px 8px;border-radius:7px;background:transparent;color:#aebeba;text-align:left;font-size:9px;cursor:pointer}.custom-dropdown-option:hover{background:rgba(var(--accent-rgb),.08);color:white}

/* interactive GTA map */
.map-shell{background:#050c0b}
.map-canvas{overflow:hidden;background:#050c0b!important;cursor:grab;user-select:none}
.map-canvas.dragging{cursor:grabbing}
.map-canvas::after{display:none}
.map-image-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#06100e}
.map-image{position:absolute;width:100%;height:100%;object-fit:contain;transform-origin:center;transition:opacity .22s var(--ease);pointer-events:none}
.map-overlay-vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at center,transparent 55%,rgba(2,8,6,.38) 100%);box-shadow:inset 0 0 45px rgba(0,0,0,.2)}
.map-mode-switch{position:absolute;right:13px;bottom:13px;display:flex;gap:6px;padding:5px;border:1px solid #27463d;background:rgba(6,16,13,.9);backdrop-filter:blur(12px);border-radius:10px;box-shadow:var(--shadow)}
.map-mode-btn{height:31px;padding:0 12px;border-radius:7px;background:transparent;color:#81958f;font-size:9.5px;font-weight:700;cursor:pointer;transition:.16s var(--ease)}.map-mode-btn:hover{color:#d9e5e1;background:rgba(255,255,255,.03)}.map-mode-btn.active{background:rgba(var(--accent-rgb),.12);color:var(--accent);box-shadow:inset 0 0 0 1px rgba(var(--accent-rgb),.17)}
.map-tools{top:13px;right:13px}.map-tools .btn{backdrop-filter:blur(10px);background:rgba(6,16,13,.88)}
.map-panel{backdrop-filter:blur(12px);background:rgba(8,18,15,.92)}

/* auth + onboarding */
.auth-layer{position:fixed;inset:0;z-index:500;display:none;align-items:center;justify-content:center;padding:24px;background:radial-gradient(circle at 50% 30%,rgba(var(--accent-rgb),.1),transparent 35%),rgba(2,7,6,.92);backdrop-filter:blur(15px)}
.auth-layer.open{display:flex;animation:fadeIn .25s var(--ease)}
.auth-card{width:min(440px,94vw);background:linear-gradient(180deg,#0d1a17,#07100e);border:1px solid #2a4a41;border-radius:17px;box-shadow:0 30px 90px rgba(0,0,0,.55);overflow:hidden;animation:modalIn .26s var(--ease)}
.auth-card.wide{width:min(720px,96vw)}
.auth-brand{padding:21px 22px 14px;display:flex;align-items:center;gap:11px}.auth-brand img{width:38px;height:38px}.auth-brand h2{font-size:14px;margin:0}.auth-brand h2 span{color:var(--accent)}.auth-brand p{font-size:9px;color:#73877f;margin:4px 0 0}
.auth-body{padding:0 22px 22px}.auth-title{font-size:20px;margin:5px 0 5px}.auth-sub{font-size:10px;color:#7e918b;line-height:1.55;margin:0 0 16px}.auth-fields{display:grid;gap:10px}.auth-field label{display:block;color:#82958f;font-size:8.5px;margin:0 0 5px}.auth-input-wrap{height:39px;border:1px solid var(--line);border-radius:9px;background:#07110f;display:flex;align-items:center;gap:9px;padding:0 11px}.auth-input-wrap:focus-within{border-color:rgba(var(--accent-rgb),.45);box-shadow:0 0 0 3px rgba(var(--accent-rgb),.055)}.auth-input-wrap i{width:14px;text-align:center;color:#738881}.auth-input-wrap input{flex:1;border:0;outline:0;background:transparent;color:#e9f1ef;font-size:10.5px}.auth-actions{display:flex;gap:8px;margin-top:14px}.auth-actions .btn{flex:1;height:38px}.auth-note{font-size:8px;color:#536761;margin-top:10px;line-height:1.45}.auth-note i{color:var(--accent);margin-right:4px}
.terminal-login{padding:21px 22px 24px}.terminal-window{border:1px solid #1f3c34;border-radius:11px;background:#030806;overflow:hidden}.terminal-bar{height:30px;border-bottom:1px solid #163029;display:flex;align-items:center;padding:0 10px;gap:5px}.terminal-dot{width:6px;height:6px;border-radius:50%;background:#315047}.terminal-content{height:190px;padding:13px;font:9.5px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;color:#76f5bd;overflow:hidden}.terminal-line{opacity:0;transform:translateY(3px);animation:termLine .25s forwards}.terminal-line .dim{color:#547269}.terminal-line .ok{color:var(--accent)}@keyframes termLine{to{opacity:1;transform:none}}.terminal-cursor{display:inline-block;width:6px;height:11px;background:var(--accent);vertical-align:-2px;animation:blink .7s steps(1) infinite}@keyframes blink{50%{opacity:0}}
.onboard-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.onboard-grid .full{grid-column:1/-1}.secret-note{font-size:8px;color:#687d76;line-height:1.45;padding:9px 10px;border:1px solid #1a302a;border-radius:8px;background:#07120f}.secret-note strong{color:#a9bbb5}
.sync-state{margin-top:12px;display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:9px;border:1px solid var(--line);background:#07110f;font-size:9px;color:#7f938c}.sync-state i{color:var(--accent)}

/* account settings modal */
.settings-tabs{display:flex;gap:5px;border-bottom:1px solid var(--line);padding:0 15px}.settings-tab{height:38px;padding:0 10px;background:transparent;color:#748980;font-size:9.5px;cursor:pointer;border-bottom:2px solid transparent}.settings-tab.active{color:var(--accent);border-color:var(--accent)}
.settings-section{display:none}.settings-section.active{display:block}
.color-field{display:flex;align-items:center;gap:9px}.color-swatch{width:34px;height:34px;border-radius:9px;border:1px solid var(--line);overflow:hidden}.color-swatch input{width:52px;height:52px;border:0;padding:0;margin:-9px;cursor:pointer}
.connection-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(var(--accent-rgb),.22);background:rgba(var(--accent-rgb),.08);border-radius:999px;padding:5px 8px;color:var(--accent);font-size:8.5px}

/* responsive centered header */
@media (max-width:1180px){.search-wrap{width:min(410px,36vw)}}
@media (max-width:860px){.sidebar{transform:translateX(-105%)}.sidebar.open{transform:none}.topbar{padding:0 10px}.search-wrap{position:relative;left:auto;transform:none;flex:1;width:auto;max-width:none;margin-right:auto}.profile{min-width:auto}.top-link{display:none}.profile-copy,.profile .chev{display:none}.map-panel{width:230px}.map-mode-switch{right:10px;bottom:10px}.onboard-grid{grid-template-columns:1fr}.onboard-grid .full{grid-column:auto}}
@media (max-width:560px){.profile{display:flex}.notification-btn{display:grid}.auth-card{width:96vw}.dropdown-popover{min-width:240px}.map-panel{display:none}}

.mobile-nav-fab{display:none;position:fixed;left:12px;bottom:12px;z-index:90;width:40px;height:40px;border-radius:11px;border:1px solid #29483f;background:rgba(7,17,14,.94);color:var(--accent);box-shadow:var(--shadow);cursor:pointer}
@media(max-width:860px){.mobile-nav-fab{display:grid;place-items:center}}
body{
  background-image:
    linear-gradient(rgba(var(--accent-rgb),.028) 1px,transparent 1px),
    linear-gradient(90deg,rgba(var(--accent-rgb),.028) 1px,transparent 1px),
    radial-gradient(circle at 68% -10%,rgba(var(--accent-rgb),.075),transparent 30%),
    linear-gradient(180deg,rgba(6,16,14,.96),rgba(4,9,8,.98));
  background-size:44px 44px,44px 44px,auto,auto;
}

/* v4 authentication / secure boot */
.boot-shell{width:min(640px,95vw);padding:26px;border:1px solid #22483d;border-radius:18px;background:linear-gradient(180deg,rgba(9,24,20,.98),rgba(3,10,8,.98));box-shadow:0 35px 110px rgba(0,0,0,.68),0 0 70px rgba(var(--accent-rgb),.07);animation:modalIn .3s var(--ease);transition:opacity .25s var(--ease),transform .25s var(--ease)}
.boot-shell.boot-exit{opacity:0;transform:scale(.975) translateY(-5px)}
.boot-mark{display:flex;align-items:center;gap:13px;margin-bottom:17px}.boot-mark img{width:42px;height:42px;filter:drop-shadow(0 0 15px rgba(var(--accent-rgb),.3))}.boot-mark strong{display:block;font-size:14px;letter-spacing:.05em}.boot-mark strong::first-line{color:#fff}.boot-mark span{display:block;margin-top:3px;color:#6e8e84;font:7.5px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.18em}
.boot-terminal{border:1px solid #18372e;border-radius:12px;background:linear-gradient(180deg,#020706,#040b09);overflow:hidden}.boot-terminal .terminal-bar{position:relative}.boot-terminal .terminal-bar span{margin-left:auto;color:#46675d;font:7.5px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em}.boot-content{height:220px;padding:17px 17px 13px;font-size:10px;line-height:2}.boot-content .terminal-line{display:grid;grid-template-columns:105px 1fr auto;gap:8px;border-bottom:1px solid rgba(57,100,87,.12)}.boot-content .boot-ready{display:block;border:0;margin-top:7px;font-weight:800;letter-spacing:.12em}.boot-progress{height:2px;background:#0c1d18}.boot-progress i{display:block;height:100%;width:0;background:var(--accent);box-shadow:0 0 15px rgba(var(--accent-rgb),.5);transition:width .22s ease}.boot-status{display:flex;justify-content:space-between;align-items:center;padding-top:12px;color:#638078;font-size:8px;text-transform:uppercase;letter-spacing:.09em}.boot-status i{color:var(--accent);margin-right:5px}.boot-status span:last-child{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--accent)}
.login-card{border-color:#24493f}.login-card .auth-brand{background:linear-gradient(135deg,rgba(var(--accent-rgb),.055),transparent 60%)}.login-kicker{display:inline-flex;align-items:center;gap:6px;padding:5px 7px;border:1px solid rgba(var(--accent-rgb),.2);border-radius:6px;background:rgba(var(--accent-rgb),.055);color:var(--accent);font-size:7px;font-weight:800;letter-spacing:.12em;margin-bottom:10px}.login-submit{width:100%;justify-content:center;min-height:36px}.test-credentials{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding:9px 10px;border:1px dashed #24473d;border-radius:9px;background:#07110e}.test-credentials span{display:block;color:#59786e;font-size:6.5px;font-weight:800;letter-spacing:.14em}.test-credentials strong{display:block;margin-top:3px;color:#cfe8df;font:8px ui-monospace,SFMono-Regular,Menlo,monospace}.copy-demo{border:1px solid #294b42;border-radius:7px;background:#0d1c18;color:#8eaaa1;padding:7px 9px;font-size:7.5px;cursor:pointer}.copy-demo:hover{border-color:var(--accent);color:var(--accent);background:rgba(var(--accent-rgb),.06)}

/* ===== PARADOX dashboard v5 polish ===== */
.search-wrap{left:46.5%;width:min(520px,38vw)}
.version-pill{border:1px solid var(--line);background:rgba(255,255,255,.018);border-radius:11px;padding:10px 11px;display:flex;align-items:center;justify-content:space-between;color:#849791;font-size:9px}.version-pill strong{color:var(--accent);font-size:10px}
.avatar{overflow:hidden}.avatar img,.avatar-image img,.player-avatar img{width:100%;height:100%;object-fit:cover;display:block;border-radius:inherit}.avatar-image{overflow:hidden}
.detail-card,.detail-row{cursor:pointer}.detail-card{transition:transform .17s var(--ease),border-color .17s var(--ease),background .17s var(--ease)}.detail-card:hover{border-color:#31574d}.detail-row:hover td{background:rgba(var(--accent-rgb),.025)}

/* Notifications stay dark regardless of browser button defaults. */
.notification-list{padding:8px;display:grid;gap:6px;background:#07110f}
.notification-card{appearance:none;width:100%;border:1px solid #1d342e;background:linear-gradient(180deg,#0d1c18,#091512);color:#dce9e5;text-align:left;grid-template-columns:36px minmax(0,1fr) auto;gap:10px;padding:10px 11px;border-radius:11px;box-shadow:inset 0 1px 0 rgba(255,255,255,.018)}
.notification-card:hover{background:linear-gradient(180deg,#11231e,#0a1814);border-color:#31564c;transform:translateY(-1px)}
.notification-card.unread{background:linear-gradient(180deg,rgba(var(--accent-rgb),.095),rgba(var(--accent-rgb),.035));border-color:rgba(var(--accent-rgb),.21)}
.notification-card .n-icon{width:36px;height:36px;border:1px solid rgba(var(--accent-rgb),.12);background:rgba(var(--accent-rgb),.095);font-size:12px}.notification-copy{min-width:0}.notification-card strong{font-size:10px;color:#e9f2ef}.notification-card p{font-size:8.5px;color:#82968f;margin:4px 0 0;line-height:1.45}.notification-card time{font-size:7.5px;color:#5f756d;padding-top:2px}.notification-footer{border-top:1px solid var(--line);padding:7px 8px}.notification-empty{background:#091411;border:1px dashed #243b35;border-radius:9px;margin:2px;color:#6f837c}

/* Support drop-down */
.support-form{padding:12px;display:grid;gap:7px;background:#08120f}.support-form label{font-size:8px;color:#7f948d;font-weight:650}.support-form .textarea{min-height:110px;resize:vertical}.support-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:4px}.support-actions .btn{min-width:86px}

/* Full-bleed GTA map: image always covers the viewport. Transform clamping in JS prevents exposing an edge. */
.map-image-stage{background:#07100e;transform-origin:center center;will-change:transform}
.map-image{object-fit:cover;object-position:center center}
.map-overlay-vignette{background:radial-gradient(circle at center,transparent 64%,rgba(2,8,6,.28) 100%)}

.field-hint{display:block;margin-top:5px;color:#60766f;font-size:7.5px;line-height:1.45}.optional-label{color:#59716a;font-weight:500}.setup-step-badge{display:inline-flex;gap:6px;align-items:center;padding:5px 7px;border:1px solid rgba(var(--accent-rgb),.2);border-radius:7px;background:rgba(var(--accent-rgb),.05);color:var(--accent);font-size:7px;font-weight:800;letter-spacing:.11em;margin-bottom:9px}.auth-actions.single .btn{max-width:none}.server-setup-card .secret-note{margin-top:2px}
.server-connection-summary{display:grid;grid-template-columns:36px 1fr auto;align-items:center;gap:10px;padding:10px 11px;border-radius:10px;border:1px solid #233b35;background:#081411;margin-bottom:13px}.server-connection-summary.linked{border-color:rgba(var(--accent-rgb),.2);background:rgba(var(--accent-rgb),.045)}.connection-orb{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:#10201c;color:#718c83}.server-connection-summary.linked .connection-orb{background:rgba(var(--accent-rgb),.1);color:var(--accent)}.server-connection-summary strong{display:block;font-size:10px}.server-connection-summary span:not(.status-chip){display:block;color:#6d817a;font-size:8px;margin-top:3px}

.player-detail-grid{display:grid;gap:12px}.player-detail-hero{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #263f38;border-radius:12px;background:linear-gradient(135deg,rgba(var(--accent-rgb),.055),#091411)}.player-avatar.large{width:52px;height:52px;border-radius:13px;font-size:18px}.player-detail-hero h2{margin:0 0 4px;font-size:17px}.player-detail-hero p{margin:0;color:#72877f;font-size:9px}.player-detail-hero .risk-chip{margin-left:auto}.player-detail-metrics{margin:0}.player-detail-grid .config-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-lines{display:grid;gap:6px}.detail-line{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid #1d312b;background:#08120f;border-radius:8px;padding:8px}.detail-line>div{min-width:0}.detail-line strong{display:block;font-size:9px;color:#d9e6e2}.detail-line span{font-size:8px;color:#6e827b}.detail-modal-card{display:grid;gap:10px}.detail-modal-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:rgba(var(--accent-rgb),.09);border:1px solid rgba(var(--accent-rgb),.15);color:var(--accent);font-size:16px}.detail-modal-card>p{margin:0;color:#778a84;font-size:9px}.modal:has(.player-detail-grid){width:min(920px,94vw)}

@media(max-width:900px){.search-wrap{left:50%;width:min(420px,44vw)}.player-detail-grid .config-grid{grid-template-columns:1fr}}


/* ===== PARADOX dashboard v6 navigation / servers / live view ===== */
.right-rail{scrollbar-width:thin}.right-rail .rail-section:first-child{margin-top:0}
.connected-servers-intro{display:flex;align-items:center;gap:11px;margin-bottom:13px;padding:11px;border:1px solid #243e37;border-radius:11px;background:#081310}.connected-servers-intro strong{display:block;font-size:10px;color:#e1ece8}.connected-servers-intro span{display:block;margin-top:3px;color:#71857e;font-size:8.5px}.connected-server-list{display:grid;gap:9px}.connected-server-card{border:1px solid #244038;border-radius:12px;background:linear-gradient(180deg,#0b1815,#07120f);padding:12px}.connected-server-top{display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:10px;align-items:center}.connected-server-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:rgba(var(--accent-rgb),.09);border:1px solid rgba(var(--accent-rgb),.14);color:var(--accent)}.connected-server-top strong{display:block;font-size:10.5px}.connected-server-top span:not(.status-chip){display:block;color:#6e837c;font-size:8px;margin-top:3px}.connected-server-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:10px}.connected-server-grid>div{padding:8px;border-radius:8px;background:#06100d;border:1px solid #182c26}.connected-server-grid span{display:block;font-size:7.5px;text-transform:uppercase;color:#5f766e;letter-spacing:.04em}.connected-server-grid strong{display:block;margin-top:4px;color:#b9cac5;font-size:8.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.modal:has(.connected-server-list){width:min(720px,94vw)}
.live-player-card{overflow:hidden;padding-top:10px}.live-player-thumbnail{height:142px;margin:-2px -2px 11px;border-radius:10px;position:relative;overflow:hidden;border:1px solid #223b34;background:#050c0a}.live-player-thumbnail>img{width:100%;height:100%;object-fit:cover;display:block}.live-thumb-demo,.live-thumb-empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:radial-gradient(circle at 65% 25%,rgba(var(--accent-rgb),.12),transparent 32%),linear-gradient(145deg,#101e1a,#07100e);color:#76918a}.live-thumb-demo::before{content:"";position:absolute;inset:0;background:linear-gradient(rgba(var(--accent-rgb),.035) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--accent-rgb),.035) 1px,transparent 1px);background-size:22px 22px}.live-thumb-demo span,.live-thumb-demo strong,.live-thumb-demo small,.live-thumb-empty span,.live-thumb-empty strong,.live-thumb-empty small{position:relative;z-index:1}.live-thumb-demo span,.live-thumb-empty span{font-size:20px;color:var(--accent)}.live-thumb-demo strong,.live-thumb-empty strong{font-size:9px;letter-spacing:.08em}.live-thumb-demo small,.live-thumb-empty small{font-size:7.5px;color:#5f766e}.live-thumb-empty{padding:14px;text-align:center}.live-feed-badge{position:absolute;right:7px;top:7px;z-index:3;display:flex;align-items:center;gap:5px;padding:4px 6px;border:1px solid rgba(var(--accent-rgb),.23);border-radius:999px;background:rgba(4,12,10,.82);color:#c8f9e8;font-size:7px;font-weight:800;letter-spacing:.08em;backdrop-filter:blur(8px)}.live-feed-badge i{width:5px;height:5px;border-radius:50%;background:var(--accent);box-shadow:0 0 7px var(--accent)}
@media(max-width:650px){.connected-server-grid{grid-template-columns:1fr}.live-player-thumbnail{height:125px}}

/* v9: stable background synchronization, screenshot thumbnails, dashboard access */
.screenshot-card{overflow:hidden;padding-top:10px}.screenshot-thumbnail{height:156px;margin:-2px -2px 11px;border-radius:10px;position:relative;overflow:hidden;border:1px solid #223b34;background:#050c0a}.screenshot-thumbnail>img{width:100%;height:100%;object-fit:cover;display:block}.screenshot-thumb-demo,.screenshot-thumb-empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:14px;text-align:center;background:radial-gradient(circle at 64% 24%,rgba(var(--accent-rgb),.12),transparent 34%),linear-gradient(145deg,#101e1a,#07100e);color:#76918a}.screenshot-thumb-demo::before{content:"";position:absolute;inset:0;background:linear-gradient(rgba(var(--accent-rgb),.035) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--accent-rgb),.035) 1px,transparent 1px);background-size:22px 22px}.screenshot-thumb-demo>* ,.screenshot-thumb-empty>*{position:relative;z-index:1}.screenshot-thumb-demo span,.screenshot-thumb-empty span{font-size:20px;color:var(--accent)}.screenshot-thumb-demo strong,.screenshot-thumb-empty strong{font-size:9px;letter-spacing:.08em}.screenshot-thumb-demo small,.screenshot-thumb-empty small{font-size:7.5px;color:#5f766e}.screenshot-evidence-badge{position:absolute;left:7px;top:7px;z-index:3;display:flex;align-items:center;gap:5px;padding:4px 7px;border:1px solid rgba(var(--accent-rgb),.23);border-radius:999px;background:rgba(4,12,10,.84);color:#c8f9e8;font-size:7px;font-weight:800;letter-spacing:.06em;backdrop-filter:blur(8px)}
.access-intro{display:flex;align-items:center;gap:11px;padding:12px;border:1px solid var(--line);border-radius:12px;background:rgba(var(--accent-rgb),.035);margin-bottom:14px}.access-intro>div:last-child{display:flex;flex-direction:column;gap:3px}.access-intro strong{font-size:11px}.access-intro span{font-size:8.5px;color:#71877f;line-height:1.45}.access-invite-row{display:grid;grid-template-columns:1fr auto;gap:9px;align-items:end;padding-bottom:15px;border-bottom:1px solid var(--line)}.access-invite-row .field{min-width:0}.access-management-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 0 8px}.access-management-head>div{display:flex;flex-direction:column;gap:2px}.access-management-head strong{font-size:10.5px}.access-management-head span:not(.tag){font-size:8px;color:#6b8079}.access-user-list{display:grid;gap:7px}.access-user-card{display:grid;grid-template-columns:38px minmax(0,1fr) auto auto;align-items:center;gap:9px;padding:9px;border:1px solid var(--line);border-radius:11px;background:#091410}.access-user-avatar .avatar{width:34px;height:34px}.access-user-copy{display:flex;flex-direction:column;gap:2px;min-width:0}.access-user-copy strong{font-size:9.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.access-user-copy span{font-size:8px;color:#7b8d87;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.access-user-copy small{font-size:7.5px;color:#536961}.access-remove{color:#ff8490}.map-shell,.map-canvas,.map-image-stage{cursor:grab}.map-canvas.dragging{cursor:grabbing}
@media(max-width:650px){.screenshot-thumbnail{height:132px}.access-invite-row{grid-template-columns:1fr}.access-user-card{grid-template-columns:36px 1fr auto}.access-user-card .access-remove{grid-column:3}}


/* ===== v10 Security + Management overhaul ===== */
.sidebar-foot{display:none!important}.nav-scroll{padding-bottom:18px}.nav-item{position:relative;padding-right:33px}.nav-split-btn{position:absolute;right:7px;top:50%;transform:translateY(-50%) scale(.86);width:24px;height:24px;border-radius:6px;border:1px solid rgba(var(--accent-rgb),.24);background:rgba(var(--accent-rgb),.07);color:var(--accent);display:grid;place-items:center;opacity:0;pointer-events:none;transition:.16s ease;font-size:10px}.nav-item:hover .nav-split-btn,.nav-item.active .nav-split-btn{opacity:1;pointer-events:auto}.nav-split-btn:hover{background:rgba(var(--accent-rgb),.16);box-shadow:0 0 14px rgba(var(--accent-rgb),.12)}
