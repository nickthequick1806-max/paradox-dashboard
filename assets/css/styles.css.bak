n-modal-profile p{margin:5px 0 0;color:#75877f}.permission-scope-list{display:grid;grid-template-columns:1fr 1fr;gap:6px}.permission-scope-list label{display:grid;grid-template-columns:18px 1fr auto;gap:7px;align-items:center;padding:8px;border:1px solid #263b34;border-radius:8px;color:#a8b7b2;font-size:8px}.permission-scope-list i,.permission-scope-list b{color:var(--accent)}.server-modal-identity{display:grid;grid-template-columns:52px 1fr auto;gap:10px;align-items:center;padding:12px;border:1px solid #263c34;border-radius:10px;background:#07100d}.server-orb{width:52px;height:52px;border-radius:12px;background:rgba(var(--accent-rgb),.1);color:var(--accent);display:grid;place-items:center;font-size:20px}.server-modal-identity span:first-child{color:var(--accent);font-size:7px}.server-modal-identity h3{margin:3px 0}.server-modal-identity p{margin:0;color:#71857d}.server-modal-columns{display:grid;grid-template-columns:1fr 1fr;gap:8px}.server-modal-columns section{display:grid;gap:6px;padding:10px;border:1px solid #263b34;border-radius:9px}.server-modal-columns h3{margin:0}.api-key-secret,.cdn-link-box{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center;padding:10px;border:1px solid #263c34;border-radius:9px;background:#050b09}.api-key-secret span,.cdn-link-box span{grid-column:1/-1;color:#6f837b;font-size:7px}.api-key-secret code,.cdn-link-box code{color:#8eebaF;font-size:8px;overflow:hidden;text-overflow:ellipsis}.api-scopes{display:flex;gap:6px;flex-wrap:wrap}.api-scopes span{padding:6px 8px;border:1px solid #25503d;border-radius:999px;background:#0b2117;color:#77dcae;font-size:7px}.ticket-modal-meta{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.ticket-conversation{padding:10px;border:1px solid #263b34;border-radius:9px}.ticket-message{display:flex;gap:8px}.ticket-message .avatar{width:34px;height:34px}.ticket-message p{margin:4px 0;color:#9aa9a4}.ticket-message span{font-size:7px;color:#667970}.ticket-compose{display:grid;grid-template-columns:1fr auto;gap:7px;margin-top:10px}.ticket-compose .textarea{min-height:65px}.backup-health{display:flex;align-items:center;gap:10px;padding:11px;border:1px solid #2b6348;border-radius:9px;background:#0c2118}.backup-health>div:first-child{font-size:24px;color:var(--accent)}.backup-health strong,.backup-health span{display:block}.backup-health span{font-size:8px;color:#7e948a}.backup-manifest{padding:10px;border:1px solid #263b34;border-radius:9px}.backup-manifest h3{margin:0 0 6px}.backup-manifest>div{display:grid;grid-template-columns:20px 1fr auto;align-items:center;padding:7px;border-top:1px solid #1f332b;color:#a6b5b0;font-size:8px}.backup-manifest>div:first-of-type{border-top:0}.backup-manifest i,.backup-manifest b{color:var(--accent)}.cdn-modal-preview{height:210px;border:1px solid #263c34;border-radius:10px;background:linear-gradient(145deg,#576c76,#182b34);display:flex;flex-direction:column;align-items:center;justify-content:center;color:white;gap:7px}.cdn-modal-preview>div{width:54px;height:54px;border-radius:50%;background:#0008;display:grid;place-items:center;font-size:18px}.cdn-modal-preview span{font-size:8px;letter-spacing:.1em}.modal:has(.section-modal){width:min(880px,94vw)}
@media(max-width:760px){.sm-grid4,.ticket-modal-meta{grid-template-columns:1fr 1fr}.identity-modal-grid,.detection-review-grid,.server-modal-columns,.log-modal-grid{grid-template-columns:1fr}.stream-modal-actions,.identity-actions{grid-template-columns:1fr 1fr}.permission-scope-list{grid-template-columns:1fr}}

/* ===== V11 MAIN + CONFIGURATION REFERENCE REBUILD ===== */
.v11-page{padding-bottom:36px}.v11-crumb{display:flex;align-items:center;gap:8px;color:#b7c0bd;font-size:11px;margin-bottom:10px}.v11-crumb span{color:var(--accent)}.v11-crumb i{font-size:8px;color:#6f7775}.v11-title{margin-bottom:16px}.v11-title-row{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;border-bottom:1px solid rgba(255,255,255,.07);padding-bottom:15px}.v11-title h1{font-size:28px;margin:0 0 6px;letter-spacing:-.025em}.v11-title h1 i{color:var(--accent);margin-right:8px}.v11-title p{margin:0;color:#9ca6a2;font-size:13px}.v11-actions{display:flex;gap:8px;align-items:center}.v11-section-title{font-size:22px;margin:24px 0 5px}.v11-section-title i{color:var(--accent);margin-right:8px}.v11-section-sub{margin:0 0 14px 28px;color:#8d9794;font-size:12px}.v11-badge{display:inline-flex;align-items:center;gap:5px;border-radius:8px;padding:5px 8px;font-size:11px;margin-left:10px}.v11-badge.bad{background:#3b1015;color:#ff616f;border:1px solid #5b171f}.v11-search{height:38px;border:1px solid #373d3b;border-radius:8px;display:flex;align-items:center;gap:9px;padding:0 11px;background:#0d0f0f}.v11-search input{width:100%;border:0;outline:0;background:transparent;color:#e7edeb}.v11-search i{color:#9fb0aa}.v11-search.grow{flex:1}.v11-filterbar{display:flex;gap:10px;padding:18px;border:1px solid #343a38;border-radius:12px;background:#0d0f0f;margin-bottom:18px}.v11-filter-btn{min-width:200px;height:40px;border:1px solid #373d3b;border-radius:8px;background:#101212;color:#f4f6f5;text-align:left;padding:0 14px}.v11-filter-btn i:first-child{color:var(--accent);margin-right:8px}.v11-filter-btn i:last-child{float:right;margin-top:4px}.v11-online-count{display:flex;align-items:center;gap:8px;margin:-7px 0 17px 5px;color:#cbd3d0}.v11-online-count b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#0b2519;color:var(--accent)}
.v11-table-card{border:1px solid #383d3b;border-radius:12px;overflow:hidden;background:#101112}.v11-table-card table{width:100%;border-collapse:collapse}.v11-table-card th{height:43px;background:#202120;text-align:left;padding:0 18px;color:#aeb8b4;text-transform:uppercase;font-size:11px;letter-spacing:.08em}.v11-table-card th i{color:var(--accent);margin-right:8px}.v11-table-card td{padding:14px 18px;border-top:1px solid #373b39;color:#d8dfdc}.v11-table-card tbody tr:hover{background:rgba(255,255,255,.025)}.v11-player-cell{display:flex;gap:10px;align-items:center}.v11-player-cell small{display:block;color:#77837f;margin-top:3px}.v11-flag{padding:5px 8px;border-radius:6px;background:#2d2611;color:#f1c44e}.v11-code-tag{display:inline-flex;padding:5px 8px;border:1px solid #17693d;background:#0b2b1a;border-radius:5px;color:#4df29e;font:600 11px ui-monospace,monospace}.v11-blue-tag{display:inline-flex;padding:5px 8px;border:1px solid #14517a;background:#0b2335;border-radius:5px;color:#38a9ff;font-size:11px}.v11-green-tag{display:inline-flex;padding:5px 8px;border:1px solid #17693d;background:#0b2b1a;border-radius:5px;color:#4df29e;font-size:11px}.v11-red-tag{display:inline-flex;padding:5px 8px;border:1px solid #7b2630;background:#331014;border-radius:5px;color:#ff5664;font-size:11px}
.v11-console-layout{display:grid;grid-template-columns:minmax(0,1fr) 285px;gap:18px;height:calc(100vh - 130px)}.v11-console,.v11-online{border:1px solid #343a38;border-radius:12px;background:#101112;overflow:hidden}.v11-console{display:grid;grid-template-rows:58px 1fr 55px}.v11-console-head{display:flex;justify-content:space-between;align-items:center;padding:0 16px;border-bottom:1px solid #373b39}.v11-console-head>div{display:flex;align-items:center;gap:10px}.v11-console-head>div:first-child>i{color:var(--accent)}.v11-console-body{display:grid;place-items:center;min-height:360px}.v11-console-error{text-align:center;color:#ee4c55;display:grid;gap:10px;justify-items:center}.v11-console-error>i{font-size:38px}.v11-retry{width:370px;height:76px;border:1px solid #174a32;border-radius:8px;background:#0e2a1d;color:var(--accent);display:flex;justify-content:space-between;align-items:center;padding:0 18px}.v11-retry i{font-size:30px}.v11-console-lines{width:100%;height:100%;padding:20px;display:flex;flex-direction:column;gap:10px;align-items:flex-start}.v11-console-lines code{color:#8fe3bf}.v11-console-input{display:grid;grid-template-columns:25px 1fr auto;align-items:center;gap:8px;padding:8px 14px;border-top:1px solid #343a38}.v11-console-input input{background:transparent;border:0;outline:0;color:#d8dfdc}.v11-online h3{height:48px;margin:0;padding:0 14px;display:flex;align-items:center;border-bottom:1px solid #373b39}.v11-online h3 i{color:var(--accent);margin-right:8px}.v11-online .v11-search{margin:12px}.v11-online-player{width:100%;display:flex;align-items:center;gap:9px;padding:10px 13px;border:0;border-top:1px solid #232725;background:transparent;color:#fff;text-align:left}.v11-online-player:hover{background:#151918}.v11-online-player small{display:block;color:#71807b;margin-top:2px}
.v11-falcon-tabs{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #383d3b;border-radius:10px;padding:7px;background:#101112;margin-bottom:28px}.v11-falcon-tabs button{height:55px;border-radius:7px;background:transparent;color:#c6cfcc;font-size:15px}.v11-falcon-tabs button i{margin-right:8px}.v11-falcon-tabs button.active{background:#183b2c;color:#4df29e}.v11-falcon-panel{border:1px solid #383d3b;border-radius:10px;padding:25px 28px;background:#111213}.v11-falcon-head{display:flex;justify-content:space-between;align-items:center}.v11-falcon-head h2{margin:0}.v11-falcon-head h2 i{color:var(--accent);margin-right:8px}.v11-falcon-head span{color:#abb4b1}.v11-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:20px}.v11-stat{border:1px solid #484b49;background:#262727;border-radius:8px;padding:18px;display:flex;gap:14px;align-items:center}.v11-stat>i{width:44px;height:44px;border-radius:8px;display:grid;place-items:center;background:#234231;color:#4df29e;font-size:20px}.v11-stat span{display:block;color:#a6aeab}.v11-stat strong{display:block;font-size:21px;margin-top:4px}.v11-chart-empty{height:210px;display:grid;place-items:center;align-content:center;gap:12px;color:#808986}.v11-chart-empty i{font-size:42px;color:#444847}.v11-section-title+.v11-section-sub{}.v11-breakdown{border:1px solid #292e2c;border-radius:10px;background:#0d0f0f;padding:16px 20px}.v11-breakdown h3{margin:0 0 15px}.v11-breakdown-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.v11-breakdown-grid .v11-stat{padding:13px}
.v11-map-shell{height:calc(100vh - 118px);border:1px solid #343a38;border-radius:12px;background:#1a9ccb;position:relative;overflow:hidden;display:grid;grid-template-columns:260px minmax(0,1fr) 300px}.v11-map-left,.v11-map-right{z-index:5;background:#101112;margin:15px;border:1px solid #323735;border-radius:10px;box-shadow:0 8px 28px #0008;overflow:hidden}.v11-map-left{margin-right:0}.v11-map-right{margin-left:0}.v11-map-left h3{display:flex;justify-content:space-between;padding:15px;margin:0;border-bottom:1px solid #303533}.v11-map-left h3 i{color:var(--accent);margin-right:7px}.v11-map-left h3 span,.v11-map-tabs b{color:#4df29e;background:#0c2419;border-radius:5px;padding:2px 6px}.v11-map-left .v11-search,.v11-map-right .v11-search{margin:14px}.v11-map-left small,.v11-map-left p{display:block;padding:0 14px}.v11-map-left small{color:#aeb7b4}.v11-map-left p{color:#aab2af}.v11-map-stage{position:relative;overflow:hidden;min-width:0}.v11-map-image{position:absolute;inset:0;transform-origin:center center;will-change:transform;display:grid;place-items:center}.v11-map-image img{width:100%;height:100%;object-fit:cover;pointer-events:none;user-select:none}.v11-map-pin{position:absolute;transform:translate(-50%,-50%);width:18px;height:18px;border-radius:50%;background:#06180f;color:#4df29e;border:2px solid #4df29e;display:grid;place-items:center;font-size:9px;font-weight:800}.v11-map-tabs{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #333836}.v11-map-tabs button{height:42px;background:transparent;color:#c6cfcc;border-bottom:2px solid transparent}.v11-map-tabs button.active{color:#4df29e;border-bottom-color:#195a38}.v11-map-cols{display:grid;grid-template-columns:1fr 1fr 1fr;padding:11px 14px;border-bottom:1px solid #333836;color:#aab3b0;text-transform:uppercase;font-size:11px}.v11-map-empty{padding:30px 15px;text-align:center;color:#a3aca8}
.v11-rule-tabs{display:flex;gap:28px;border-bottom:1px solid rgba(255,255,255,.07);margin-bottom:20px;padding-left:6px}.v11-rule-tabs button{height:46px;background:transparent;color:#c4cdca;border-bottom:2px solid transparent}.v11-rule-tabs button i{margin-right:7px}.v11-rule-tabs button.active{color:#4df29e;border-bottom-color:#1a6e45}.v11-2col{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.v11-3col{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.v11-5col{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:26px 0}.v11-toggle-row{min-height:72px;border:1px solid #3b403e;border-radius:9px;background:#121414;padding:13px 16px;display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:12px}.v11-toggle-row>i{width:38px;height:38px;border-radius:8px;background:#1d3028;display:grid;place-items:center;color:#4df29e;font-size:18px}.v11-toggle-row strong{display:block}.v11-toggle-row span{display:block;color:#9ca6a2;font-size:11px;margin-top:5px}.v11-wide-card,.v11-rule-card,.v11-entity-list{border:1px solid #383d3b;border-radius:10px;background:#111313;padding:20px;margin-bottom:18px}.v11-wide-card>h3:first-child,.v11-entity-list>h3{margin-top:0}.v11-warning{margin-top:12px;background:#231907;border:1px solid #61420d;color:#f2b946;padding:10px 12px;border-radius:6px}.v11-warning i{margin-right:8px}.v11-info{display:flex;gap:10px;padding:16px;border:1px solid #123955;border-radius:8px;background:#08141b;color:#18a9ff;margin:14px 0}.v11-info.green{border-color:#174a33;background:#10281d;color:#69e6a9}.v11-info.blue{margin-top:18px}.v11-info strong,.v11-info span{display:block}.v11-info span{margin-top:5px;color:#aab7b2}.v11-textarea{width:100%;min-height:105px;border:1px solid #3a3f3d;border-radius:8px;background:#101112;color:#dbe2df;padding:14px;resize:vertical;margin:8px 0 14px}.v11-list-head{display:flex;justify-content:space-between;align-items:center}.v11-manage-row{width:100%;height:36px;border:1px solid #3a403d;border-radius:5px;background:#101112;color:#aab4b0;text-align:left;padding:0 12px}.v11-rule-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;border:1px solid #363b39;border-radius:10px;padding:20px;background:#111313}.v11-rule-card{margin:0}.v11-rule-card h3{margin-top:0}.v11-rule-card label{display:block;margin:15px 0 7px;color:#c4ceca}.v11-weapon-action{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin:12px 0}.v11-chipbox{border:1px solid #3b403e;border-radius:7px;padding:8px;display:flex;flex-wrap:wrap;gap:4px;background:#101112}.v11-chipbox span{border:1px solid #4a4f4d;border-radius:4px;padding:4px 6px;background:#141616;font-size:10px}.v11-chipbox button{background:transparent;color:#aab3af}.v11-pill-filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.v11-pill-filters button{height:30px;padding:0 14px;border:1px solid #3e4341;border-radius:999px;background:#111313;color:#c9d1ce}.v11-pill-filters button.active{background:#143625;border-color:#22774a;color:#4df29e}.v11-advanced-row{display:grid;grid-template-columns:1.2fr 1.2fr 1fr auto auto;gap:16px;align-items:center;padding:15px 0;border-top:1px solid #2f3432}.v11-bottom-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:16px}.btn.purple{background:#2b123e;border-color:#592172;color:#ca7bff}.btn.warning{background:#ff9200;color:#fff;border-color:#ff9200}.v11-webhooks{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;border:1px solid #383d3b;border-radius:9px;padding:20px;background:#111313;margin:24px 0}.v11-webhooks label{font-weight:700}.v11-webhooks input{display:block;width:100%;margin-top:7px;height:38px;border:1px solid #3a403e;border-radius:6px;background:#111313;color:#fff;padding:0 10px}.v11-detector-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;border:1px solid #1e2220;background:#0e1010;padding:24px;border-radius:10px}.v11-detector-card{min-height:60px;border:1px solid #454a47;border-radius:6px;background:#111313;padding:9px 8px;display:grid;grid-template-columns:1fr auto auto;gap:7px;align-items:center}.v11-detector-card strong,.v11-detector-card span{display:block}.v11-detector-card strong{font-size:11px}.v11-detector-card span{font-size:9px;color:#9aa4a0;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.v11-detector-card .icon-btn{width:28px;height:28px;border:1px solid #4a4f4c}.v11-safety-grid{display:grid;grid-template-columns:1.05fr 1fr 1.05fr;gap:18px}.v11-safety-card{border:1px solid #383d3b;border-radius:10px;background:#111313;padding:20px}.v11-safety-card h2{font-size:18px;margin:0 0 5px}.v11-safety-card h2 i{color:var(--accent);margin-right:7px}.v11-safety-card>p{margin:0 0 20px;color:#9ca6a2}.v11-safety-card>label{display:block;border:1px solid #383d3b;border-radius:8px;background:#151717;padding:15px;margin-top:14px}.v11-safety-card label b{float:right;color:#4df29e;background:#0b2b1a;padding:6px 10px;border-radius:4px}.v11-safety-card input[type=range]{display:block;width:100%;margin-top:20px;accent-color:#49e69c}.v11-rule-form{display:grid;grid-template-columns:1fr 1fr;gap:10px}.v11-rule-form .btn{grid-column:2}.v11-active-rule{display:grid;grid-template-columns:auto 1fr auto auto;gap:10px;align-items:center;border:1px solid #373c3a;border-radius:7px;padding:12px}.v11-segment{display:flex;border:1px solid #333836;border-radius:7px;overflow:hidden}.v11-segment button{height:36px;padding:0 18px;background:#111313;color:#c2cbc8}.v11-segment button.active{background:#4de18f;color:#07130e}.v11-kv-list{display:grid;gap:8px;margin:14px 0}.v11-kv-list>div{display:flex;justify-content:space-between;padding:10px 12px;border:1px solid #333836;border-radius:7px}.v11-security-tools{display:flex;gap:10px;align-items:center;margin-bottom:14px}.v11-advanced{display:flex;gap:6px;align-items:center;color:#c3cbc8}.v11-ruleset{border:1px solid #383d3b;border-radius:8px;background:#111313;margin-bottom:10px;overflow:hidden}.v11-ruleset-head{display:grid;grid-template-columns:18px 34px 1fr auto;gap:8px;align-items:center;padding:10px 12px}.v11-ruleset-head>i{color:#cdd4d1}.v11-ruleset-head small{display:block;color:#9ca6a2;margin-top:4px}.v11-square-icon{width:28px;height:28px;border-radius:6px;background:#123d29;color:#4df29e;display:grid;place-items:center}.v11-rule-line{display:grid;grid-template-columns:30px 42px 1.2fr 1fr 45px 45px 80px 35px;gap:8px;align-items:center;padding:8px 12px;border-top:1px solid #303533}.v11-rule-line small{display:block;color:#929c98}.v11-order{text-align:center;font-weight:800}.v11-ruleset.compact{background:#242525}.v11-native-editor{display:grid;grid-template-columns:210px 1fr;gap:16px;min-height:400px}.v11-native-editor aside{display:flex;flex-direction:column;gap:8px}.v11-native-editor aside>button{display:grid;grid-template-columns:28px 1fr auto;gap:8px;align-items:center;text-align:left;padding:11px;border:0;border-radius:8px;background:#111313;color:#e8edeb}.v11-native-editor aside>button.active{background:#3b2918}.v11-native-editor aside b{width:24px;height:24px;border-radius:50%;background:#2bbd86;display:grid;place-items:center}.v11-native-editor aside small{display:block;color:#a1aba7}.v11-native-editor section{border:1px solid #353a38;border-radius:8px;padding:20px;background:#111313}.v11-expression{margin-top:10px;border:1px solid #333836;border-radius:8px;padding:10px}.v11-expression strong,.v11-expression code{display:block}.v11-expression code{margin-top:8px;color:#d5ddd9}
@media(max-width:1200px){.v11-5col,.v11-detector-grid{grid-template-columns:repeat(3,1fr)}.v11-safety-grid{grid-template-columns:1fr}.v11-console-layout{grid-template-columns:1fr}.v11-online{display:none}.v11-map-shell{grid-template-columns:210px minmax(0,1fr)}.v11-map-right{display:none}.v11-stat-grid,.v11-breakdown-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.v11-2col,.v11-3col,.v11-5col,.v11-rule-grid,.v11-webhooks,.v11-detector-grid,.v11-stat-grid,.v11-breakdown-grid{grid-template-columns:1fr}.v11-map-shell{grid-template-columns:1fr}.v11-map-left{display:none}.v11-filterbar{flex-direction:column}.v11-advanced-row{grid-template-columns:1fr}.v11-native-editor{grid-template-columns:1fr}.v11-rule-line{grid-template-columns:30px 42px 1fr 35px}.v11-rule-line code,.v11-rule-line>span:nth-last-of-type(-n+3){display:none}}
.v11-map-mode{position:absolute;right:16px;bottom:16px;z-index:7;display:flex;gap:4px;padding:4px;border:1px solid #3a403e;border-radius:8px;background:#0f1111cc;backdrop-filter:blur(8px)}.v11-map-mode button{height:30px;padding:0 12px;border-radius:6px;background:transparent;color:#aeb7b4}.v11-map-mode button.active{background:#123523;color:#4df29e}

/* === V12 PROFESSIONAL POLISH === */
.ref-page,.v11-page{padding:22px 24px 34px}.ref-page>.v11-title,.ref-page>.ref-page-title{margin-bottom:20px}.ref-page section,.ref-page article,.ref-page .v11-wide-card,.ref-page .v11-table-card{box-sizing:border-box}.ref-page h1,.ref-page h2,.ref-page h3{letter-spacing:-.02em}.ref-page .btn,.ref-page .icon-btn{flex-shrink:0}.v11-toggle-row,.v11-rule-card,.v11-safety-card,.v11-wide-card,.v11-table-card,.v11-ruleset,.detail-panel,.member-table,.pending-box{box-shadow:0 10px 30px rgba(0,0,0,.07)}
.v11-2col,.v11-3col,.v11-5col,.v11-rule-grid,.v11-stat-grid,.server-details-grid{gap:18px}.v11-detector-grid{gap:10px}.v11-toggle-row{min-height:78px;padding:14px 16px}.v11-toggle-row>i{font-size:15px;width:38px;height:38px}.v11-detector-card{min-height:66px;padding:10px 11px;gap:9px}.v11-detector-card strong{font-size:10.5px}.v11-detector-card .switch{margin-left:3px}.v11-rule-card{padding:18px}.v11-page hr{border:0;border-top:1px solid rgba(255,255,255,.07);margin:22px 0}.v11-section-title{margin:26px 0 5px}.v11-section-sub{margin:0 0 18px}.v11-table-card{overflow:hidden}.v11-table-card table{width:100%;border-collapse:collapse}.v11-table-card th,.v11-table-card td{padding:13px 15px}.v11-table-card tbody tr+tr{border-top:1px solid #303533}

/* Only genuinely interactive rows get pointer feedback. */
.detail-card,.detail-row{cursor:default}.detail-row[data-player],.player-card[data-player],[data-detail-modal="true"]{cursor:pointer}.detail-row[data-player]:hover,.player-card[data-player]:hover,[data-detail-modal="true"]:hover{background:rgba(var(--accent-rgb),.035)}

/* Player lookup icon / hero */
.lookup-hero h1 i{color:var(--accent);font-size:.78em;margin-right:8px}.lookup-search{box-shadow:0 14px 38px rgba(0,0,0,.18)}

/* Full-screen matrix/terminal rain boot. */
.auth-layer:has(.v12-boot){padding:0;background:#010504;backdrop-filter:none;overflow:hidden}.v12-boot{position:absolute;inset:0;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(var(--accent-rgb),.1),transparent 27%),linear-gradient(180deg,#010504,#020907 72%,#010403);transition:opacity .55s ease,transform .55s ease}.v12-boot.exit{opacity:0;transform:scale(1.025)}.v12-rain{position:absolute;inset:-18% 0 34%;display:grid;grid-template-columns:repeat(26,1fr);gap:8px;mask-image:linear-gradient(#000 0%,#000 58%,transparent 100%);opacity:.62}.v12-rain-col{display:flex;flex-direction:column;align-items:center;gap:7px;color:var(--accent);font:7px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;animation:v12Rain var(--speed) linear infinite;animation-delay:var(--delay);text-shadow:0 0 10px rgba(var(--accent-rgb),.42)}.v12-rain-col:nth-child(3n){opacity:.45}.v12-rain-col:nth-child(4n){opacity:.75}.v12-rain-col span:nth-child(4n){color:#baffdf}.v12-boot-vignette{position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,transparent 15%,rgba(0,4,3,.25) 50%,rgba(0,3,2,.88) 100%);pointer-events:none}.v12-boot-brand{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);display:flex;align-items:center;gap:20px;z-index:4;animation:v12BrandIn .72s cubic-bezier(.2,.9,.2,1) both}.v12-boot-brand img{width:74px;height:74px;filter:drop-shadow(0 0 28px rgba(var(--accent-rgb),.38));animation:v12LogoPulse 1.25s ease-in-out infinite alternate}.v12-boot-brand strong{display:block;font-size:36px;letter-spacing:-.035em;white-space:nowrap}.v12-boot-brand strong em{font-style:normal;color:var(--accent)}.v12-boot-brand span{display:block;margin-top:7px;color:#6f9186;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.26em}.v12-boot-status{position:absolute;left:50%;top:61%;transform:translateX(-50%);z-index:5;color:#78a596;font:8px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.22em;animation:fadeIn .4s both}@keyframes v12Rain{from{transform:translateY(-28%)}to{transform:translateY(34%)}}@keyframes v12BrandIn{from{opacity:0;transform:translate(-50%,-44%) scale(.94);filter:blur(7px)}to{opacity:1;transform:translate(-50%,-50%) scale(1);filter:none}}@keyframes v12LogoPulse{to{filter:drop-shadow(0 0 42px rgba(var(--accent-rgb),.58))}}

/* Falcon reference-style tabs and breakdowns. */
.v12-falcon .v11-falcon-tabs{margin-bottom:26px}.v12-falcon .v11-falcon-tabs button{min-height:58px;font-size:13px}.v12-falcon .v11-falcon-tabs button.active.green{background:#123723;color:#55ee9d}.v12-falcon .v11-falcon-tabs button.active.red{background:#402020;color:#ff626b;border-color:#722c32}.v12-falcon .v11-falcon-tabs button.active.purple{background:#2c1d33;color:#d96aff;border-color:#573060}.v12-falcon .v11-falcon-tabs button.active.orange{background:#412b0f;color:#ff9f1b;border-color:#714a13}.v12-falcon-head-actions{display:flex;align-items:center;gap:14px}.v12-falcon-breakdown{border:1px solid #333836;border-radius:10px;background:#101212;padding:18px 20px;margin-bottom:18px}.v12-falcon-breakdown>h3{margin:0 0 16px;padding-bottom:14px;border-bottom:1px solid #323735}.v12-falcon-metrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.v12-falcon-metric{min-height:108px;border:1px solid #393e3c;border-radius:8px;background:#292a2a;padding:17px 20px;position:relative;overflow:hidden}.v12-falcon-metric::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent)}.v12-falcon-metric.red::before{background:#ff5d68}.v12-falcon-metric.purple::before{background:#b65cff}.v12-falcon-metric.orange::before{background:#ff9700}.v12-falcon-metric span{display:block;color:#adb7b3;font-size:11px}.v12-falcon-metric strong{display:block;margin-top:14px;font-size:26px}.v12-top-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.v12-top-card{min-height:190px;border:1px solid #3a3f3d;border-radius:10px;background:#101212;padding:18px}.v12-top-card h3{margin:0;padding-bottom:14px;border-bottom:1px solid #353a38}.v12-top-card h3 i{color:var(--accent);margin-right:8px}.v12-top-empty{height:120px;display:grid;place-items:center;color:#a6b0ac}.v12-top-bar{width:100%;display:flex;justify-content:space-between;gap:12px;border:1px solid #2d3431;border-radius:7px;padding:12px;background:#161918}.v12-top-bar b{color:var(--accent)}

/* Map + polygon zone designer. */
.v12-map-shell{position:relative;display:grid;grid-template-columns:250px minmax(0,1fr) 285px;min-height:calc(100vh - 145px);border:1px solid #136a82;border-radius:11px;background:#0b1110;overflow:hidden;box-shadow:0 0 0 1px rgba(15,187,238,.12),0 18px 60px rgba(0,0,0,.18)}.v12-map-shell.left-closed{grid-template-columns:0 minmax(0,1fr) 285px}.v12-map-shell.right-closed{grid-template-columns:250px minmax(0,1fr) 0}.v12-map-shell.left-closed.right-closed{grid-template-columns:0 minmax(0,1fr) 0}.v11-map-left,.v11-map-right{position:relative;min-width:0;overflow:visible;transition:.2s ease}.v11-map-left.closed,.v11-map-right.closed{width:0;border:0}.v11-map-left.closed .v12-map-side-content,.v11-map-right.closed .v12-map-side-content{display:none}.v12-map-collapse{position:absolute;top:14px;z-index:30;width:27px;height:42px;border:1px solid #454a48;border-radius:6px;background:#101313;color:#dce6e2;display:grid;place-items:center;cursor:pointer}.v12-map-collapse.left{right:-15px}.v12-map-collapse.right{left:-15px}.v11-map-left.closed .v12-map-collapse.left{right:-29px}.v11-map-right.closed .v12-map-collapse.right{left:-29px}.v12-map-side-content{height:100%;overflow:auto;background:#101212}.v12-zone-browser{padding:14px}.v12-zone-browser .full{width:100%;margin:10px 0 15px}.v12-zone-card,.v12-zone-list button{width:100%;display:flex;align-items:center;gap:10px;text-align:left;border:1px solid #303633;border-radius:8px;background:#121615;color:#d9e3df;padding:10px;margin-top:8px}.v12-zone-card>i,.v12-zone-list button>i{width:30px;height:30px;border-radius:7px;background:#123722;color:var(--accent);display:grid;place-items:center}.v12-zone-card small,.v12-zone-list small{display:block;color:#82918c;margin-top:3px}.v12-zone-list{padding:14px;border-top:1px solid #2e3431;margin-top:15px}.v12-zone-list>strong{display:block;color:#b8c3bf;margin-bottom:8px}.v12-zone-editor{padding:0 14px 14px}.v12-zone-editor-head{height:47px;margin:0 -14px 14px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #333937}.v12-zone-editor>label{display:block;font-size:9px;font-weight:800;color:#c2cbc7;margin:12px 0 6px}.v12-zone-editor>.input,.v12-zone-editor>.custom-dropdown{width:100%}.v12-zone-editor>p{font-size:8.5px;line-height:1.5;color:#a0aaa6}.v12-zone-shape{display:flex;align-items:center;justify-content:space-between}.v12-nudge-amounts{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin:8px 0}.v12-nudge-amounts button{height:29px;border:1px solid #3d4340;border-radius:4px;background:#111313;color:#d7dfdc}.v12-nudge-amounts button.active{color:var(--accent);border-color:var(--accent);background:#0e291d}.v12-nudge-grid{width:210px;margin:10px auto;display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.v12-nudge-grid button{height:65px;border:1px solid #414744;border-radius:6px;background:#111313;color:#fff;font-size:17px}.v12-nudge-grid button:first-child{grid-column:2}.v12-nudge-grid button:nth-child(2){grid-row:2;grid-column:1}.v12-nudge-grid .center{grid-row:2;grid-column:2}.v12-nudge-grid button:nth-child(4){grid-row:2;grid-column:3}.v12-nudge-grid button:last-child{grid-row:3;grid-column:2}.v12-checks{display:grid;gap:8px}.v12-checks label{display:flex;align-items:center;gap:7px;font-size:10px}.v12-zone-actions{position:sticky;bottom:-14px;margin:16px -14px -14px;padding:12px 14px;display:grid;grid-template-columns:1fr 1fr;gap:8px;border-top:1px solid #343a37;background:#101212}.v12-zone-toolbar{position:absolute;z-index:25;top:14px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:10px;border:1px solid #385344;border-radius:999px;background:#08110dcc;color:var(--accent);padding:8px 14px;backdrop-filter:blur(10px);font-size:9px;box-shadow:0 10px 35px rgba(0,0,0,.25)}.v12-zone-toolbar button{background:transparent;color:var(--accent);width:24px;height:24px}.v12-zone-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}.v12-zone-svg polyline{fill:rgba(255,159,20,.13);stroke:#ff9f14;stroke-width:.35;stroke-dasharray:1 1;vector-effect:non-scaling-stroke}.v12-zone-node{position:absolute;z-index:12;transform:translate(-50%,-50%);width:18px;height:18px;border-radius:50%;background:#03120b;color:#fff;border:2px solid #1de58a;font-size:8px;font-weight:800;box-shadow:0 0 0 2px rgba(0,0,0,.35)}.v12-zone-node.first{background:var(--accent);color:#062015}.v12-map-zoom{position:absolute;right:14px;bottom:55px;z-index:20;display:grid;gap:5px}.v12-map-zoom button{width:34px;height:34px;border:1px solid #38433f;border-radius:6px;background:#101514;color:#fff;font-size:18px}.zone-drawing{cursor:crosshair!important}

/* Reference-style player detail modal. */
.modal:has(.v12-player-modal){width:min(1500px,96vw);max-height:90vh;background:#0e1010}.modal:has(.v12-player-modal) .modal-head{display:none}.modal:has(.v12-player-modal) .modal-body{padding:0;overflow:hidden}.v12-player-modal{display:grid;grid-template-columns:1.45fr .95fr;min-height:760px}.v12-player-left{padding:22px;overflow:auto}.v12-player-right{border-left:1px solid #363b39;padding:0 16px 16px;overflow:auto}.v12-block-title{display:flex;align-items:center;gap:8px;font-weight:800;margin:0 0 12px}.v12-block-title i{color:var(--accent)}.v12-block-title b{font-size:9px;color:#aeb8b4}.v12-identifiers{border:1px solid #363b39;border-radius:8px;overflow:hidden;margin-bottom:28px}.v12-id-row{display:grid;grid-template-columns:200px 1fr 35px;align-items:center;gap:10px;min-height:44px;padding:0 12px;border-bottom:1px solid #313634}.v12-id-row:last-child{border:0}.v12-id-row span{color:#aeb8b4}.v12-id-row span i{margin-right:7px}.v12-id-row code{font-size:9px;color:#c6cfcc;overflow:hidden;text-overflow:ellipsis}.v12-player-detections{border:1px solid #363b39;border-radius:8px;overflow:auto;margin-bottom:24px}.v12-player-detections table{width:100%;border-collapse:collapse}.v12-player-detections th,.v12-player-detections td{padding:13px 12px;text-align:left;border-bottom:1px solid #313634}.v12-player-detections th{background:#202221;color:#a8b1ad;font-size:9px}.v12-player-context-tabs{display:flex;gap:8px}.v12-player-context-tabs button{height:35px;padding:0 14px;border:1px solid #3b403e;border-radius:6px;background:#111313;color:#9ea8a4}.v12-player-context-tabs button.active{color:var(--accent);border-color:#20724b;background:#10261c}.v12-player-context-empty{margin-top:8px;min-height:150px;border:1px solid #343a37;border-radius:8px;padding:18px;color:#889892}.v12-player-context-empty strong{color:#e4ece9;margin-left:7px}.v12-player-tabs{height:48px;display:flex;gap:6px;border-bottom:1px solid #333836;position:sticky;top:0;background:#0e1010;z-index:2}.v12-player-tabs button{background:transparent;color:#929d99;padding:0 12px;border-bottom:2px solid transparent}.v12-player-tabs button.active{color:#fff;border-color:var(--accent)}.v12-player-profile{padding:15px 0 12px}.v12-player-profile h2{font-size:24px;margin:8px 0}.v12-offline,.v12-risk-badge{display:inline-flex;border:1px solid #494d4c;border-radius:5px;padding:4px 8px;color:#aeb6b3;font-size:9px}.v12-risk-badge{border-color:#4f3769;color:#c57bff}.v12-player-kpis{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px}.v12-player-kpis>div{border:1px solid #3a403d;border-radius:8px;padding:13px}.v12-player-kpis span{display:block;color:#9aa5a1;font-size:9px}.v12-player-kpis span i{color:var(--accent);margin-right:6px}.v12-player-kpis strong{display:block;font-size:16px;margin-top:9px}.v12-server-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-height:270px;overflow:auto}.v12-joined-server{display:grid;grid-template-columns:40px 1fr auto;gap:9px;align-items:center;border:1px solid #383d3b;border-radius:8px;padding:9px}.v12-server-thumb{width:36px;height:36px;border-radius:7px;background:#1a201e;color:var(--accent);display:grid;place-items:center}.v12-joined-server strong,.v12-joined-server small{display:block}.v12-joined-server small{color:#899691;margin-top:3px}.v12-joined-server b{font-size:8px;color:#7f8985}.v12-player-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.v12-player-actions .btn{height:40px}

/* Permissions matching the supplied reference pages. */
.v12-permissions .permission-tabs{gap:0}.v12-permissions .permission-tabs button{min-width:135px;height:45px}.permission-empty-row,.permission-empty-wide{border:1px dashed #444a47;border-radius:8px;min-height:58px;display:flex;align-items:center;gap:12px;padding:0 18px;color:#a8b2ae}.permission-empty-row i{font-size:18px;color:#5d6461}.bypass-table{border:1px solid #3c413f;border-radius:9px;overflow:hidden}.permission-empty-wide{border:0;border-top:1px solid #353a38;border-radius:0;justify-content:center;min-height:125px}.v12-form-modal>p{color:#8f9d98;margin:-4px 0 18px}.v12-form-modal>label{display:block;margin:13px 0 6px;color:#aeb8b4}.v12-color-row,.v12-select-input{height:39px;border:1px solid #3a403d;border-radius:7px;background:#111313;display:flex;align-items:center;gap:9px;padding:0 11px;color:#dce4e1}.v12-color-row span{width:18px;height:18px;border-radius:4px}.v12-color-row i{margin-left:auto}.v12-select-input{width:100%;justify-content:space-between}.v12-permission-list{max-height:330px;overflow:auto;border:1px solid #393e3c;border-radius:8px}.v12-permission-list>label{min-height:62px;display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;padding:10px 14px;border-bottom:1px solid #343937}.v12-permission-list>label:last-child{border:0}.v12-permission-list strong,.v12-permission-list span{display:block}.v12-permission-list span{font-size:9px;color:#939e99;margin-top:4px}.v12-info-note{display:flex;gap:8px;margin-top:14px;padding:11px;border:1px solid #1f4937;border-radius:7px;background:#0f261c;color:#9aada5}.v12-info-note i{color:var(--accent)}.v12-info-note button{background:none;color:var(--accent);text-decoration:underline}

@media(max-width:1250px){.v12-falcon-metrics{grid-template-columns:repeat(3,1fr)}.v12-top-grid{grid-template-columns:1fr 1fr}.v12-player-modal{grid-template-columns:1fr}.v12-player-right{border-left:0;border-top:1px solid #363b39}.v12-map-shell{grid-template-columns:220px minmax(0,1fr) 250px}}
@media(max-width:900px){.v12-map-shell,.v12-map-shell.left-closed,.v12-map-shell.right-closed{grid-template-columns:1fr}.v11-map-left,.v11-map-right{display:none}.v12-falcon-metrics,.v12-top-grid{grid-template-columns:1fr 1fr}.v12-player-kpis,.v12-server-grid{grid-template-columns:1fr}.v12-boot-brand strong{font-size:25px}.v12-boot-brand img{width:56px;height:56px}}


/* === V13 visual, viewport and interaction refinement === */
body.preboot,body.auth-active{background:#010504!important}
body.preboot .app-shell,body.auth-active .app-shell{opacity:0!important;visibility:hidden!important;pointer-events:none!important}
body:not(.auth-active) .app-shell{opacity:1;visibility:visible;transition:opacity .28s ease}
body.preboot .auth-layer{display:flex!important;background:#010504!important}
.v13-preboot{display:flex;align-items:center;gap:13px;color:#dff8ef;font-weight:900;font-size:17px;letter-spacing:-.02em;opacity:.8}.v13-preboot img{width:42px;height:42px;filter:drop-shadow(0 0 22px rgba(var(--accent-rgb),.3))}.v13-preboot span{background:linear-gradient(90deg,#fff 0 52%,var(--accent) 52%);-webkit-background-clip:text;background-clip:text;color:transparent}

.auth-layer:has(.v13-boot){padding:0;background:#010504;backdrop-filter:none;overflow:hidden}.v13-boot{position:absolute;inset:0;overflow:hidden;background:radial-gradient(ellipse at 50% 43%,rgba(var(--accent-rgb),.075),transparent 33%),linear-gradient(180deg,#010504 0%,#020806 58%,#010403 100%);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.8,.2,1)}.v13-boot.exit{opacity:0;transform:scale(1.018)}.v13-rain-canvas{position:absolute;inset:0;width:100%;height:100%;opacity:.82;mask-image:linear-gradient(to bottom,#000 0,#000 16%,rgba(0,0,0,.92) 35%,rgba(0,0,0,.18) 55%,transparent 63%)}.v13-boot-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(var(--accent-rgb),.018) 1px,transparent 1px),linear-gradient(90deg,rgba(var(--accent-rgb),.015) 1px,transparent 1px);background-size:58px 58px;mask-image:linear-gradient(#000 0%,rgba(0,0,0,.6) 46%,transparent 72%)}.v13-boot-vignette{position:absolute;inset:0;background:radial-gradient(circle at 50% 49%,transparent 0 19%,rgba(1,5,4,.15) 42%,rgba(1,4,3,.88) 100%),linear-gradient(180deg,transparent 0 45%,rgba(1,4,3,.78) 70%,#010403 100%);pointer-events:none}.v13-boot-brand{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);z-index:4;display:flex;align-items:center;gap:22px;animation:v13BrandIn .88s cubic-bezier(.16,1,.3,1) both}.v13-boot-brand:after{content:"";position:absolute;left:0;right:0;bottom:-20px;height:1px;background:linear-gradient(90deg,transparent,rgba(var(--accent-rgb),.5),transparent);transform:scaleX(0);animation:v13Scan 1.1s .28s cubic-bezier(.16,1,.3,1) forwards}.v13-boot-brand img{width:74px;height:74px;filter:drop-shadow(0 0 18px rgba(var(--accent-rgb),.33));animation:v13LogoIn .95s cubic-bezier(.16,1,.3,1) both}.v13-boot-brand strong{display:block;font-size:37px;line-height:1;letter-spacing:-.045em;white-space:nowrap}.v13-boot-brand strong em{font-style:normal;color:var(--accent)}.v13-boot-brand span{display:block;margin-top:9px;color:#66847b;font:8px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.30em}.v13-boot-status{position:absolute;left:50%;top:61%;transform:translateX(-50%);z-index:5;display:flex;align-items:center;gap:9px;color:#70978a;font:7.5px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.24em;white-space:nowrap}.v13-boot-status i{width:5px;height:5px;border-radius:50%;background:var(--accent);box-shadow:0 0 14px rgba(var(--accent-rgb),.65);animation:v13Pulse .8s ease-in-out infinite alternate}.v13-boot-status span.swap{animation:v13Status .35s ease both}@keyframes v13BrandIn{from{opacity:0;transform:translate(-50%,-44%) scale(.94);filter:blur(8px)}to{opacity:1;transform:translate(-50%,-50%) scale(1);filter:none}}@keyframes v13LogoIn{from{opacity:0;transform:translateX(-18px) rotate(-8deg) scale(.86)}to{opacity:1;transform:none}}@keyframes v13Scan{to{transform:scaleX(1)}}@keyframes v13Pulse{to{opacity:.35;transform:scale(.8)}}@keyframes v13Status{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

/* Fit map and console into the viewport without forcing page-level scrolling. */
.v13-console-page{padding-bottom:12px!important}.v13-console-layout{height:min(690px,calc(100vh - 174px))!important;min-height:500px!important}.v11-console-body{min-height:0!important;overflow:auto}.v11-console-lines{overflow:auto}.v11-online{display:flex!important;flex-direction:column;min-height:0}.v11-online h3,.v11-online>.v11-search{flex:0 0 auto}.v13-online-list{min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#294139 transparent}.v13-online-list::-webkit-scrollbar{width:6px}.v13-online-list::-webkit-scrollbar-thumb{background:#294139;border-radius:10px}
.page:has(.v12-map-shell){padding-bottom:10px!important}.v12-map-shell{height:min(720px,calc(100vh - 150px))!important;min-height:540px!important}.v11-map-left,.v11-map-right{margin:10px!important;background:rgba(5,14,12,.28)!important;border-color:rgba(105,145,132,.24)!important;box-shadow:none!important;backdrop-filter:blur(11px) saturate(110%)}.v11-map-left{margin-right:0!important}.v11-map-right{margin-left:0!important}.v12-map-side-content{background:linear-gradient(180deg,rgba(8,17,15,.62),rgba(5,12,10,.46))!important;backdrop-filter:blur(15px) saturate(115%)}.v12-map-collapse{background:rgba(8,16,14,.82)!important;backdrop-filter:blur(8px)}

/* Professional spacing audit: never let adjacent cards visually fuse. */
.v11-2col,.v11-3col,.v11-5col,.v11-rule-grid,.v11-stat-grid,.server-details-grid,.v12-falcon-metrics,.v12-top-grid{gap:18px!important}.v11-wide-card>.v11-toggle-row+.v11-toggle-row,.v11-entity-list>.v11-toggle-row+.v11-toggle-row,.v11-safety-card>.v11-toggle-row+.v11-toggle-row{margin-top:12px}.v11-entity-list>.v11-toggle-row{margin-bottom:12px}.v11-rule-card+.v11-rule-card,.detail-panel+.detail-panel{margin-top:0}.v11-table-card tbody tr{cursor:pointer}.ref-table tbody tr.detail-row,.data-table tbody tr.detail-row,.backup-row-ref,.cdn-file-card,.detail-panel,.v11-rule-line,.v11-active-rule,.member-row,.server-detail-row{cursor:pointer;transition:background .16s ease,border-color .16s ease,transform .16s ease}.ref-table tbody tr.detail-row:hover,.data-table tbody tr.detail-row:hover,.backup-row-ref:hover,.cdn-file-card:hover,.detail-panel:hover,.v11-rule-line:hover,.v11-active-rule:hover,.member-row:hover,.server-detail-row:hover{background-color:rgba(var(--accent-rgb),.035)!important;border-color:rgba(var(--accent-rgb),.22)!important}

/* Player intelligence tabs. */
.v13-player-tab-panel{padding:15px 0 0;min-height:520px}.v13-note-compose{border:1px solid #373d3a;border-radius:9px;background:#111313;padding:13px}.v13-note-compose textarea{min-height:88px;resize:vertical}.v13-note-compose>div{display:flex;align-items:center;justify-content:space-between;margin-top:9px;color:#7f8d88;font-size:9px}.v13-tab-list{display:grid;gap:9px;margin-top:14px}.v13-tab-list article{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:start;border:1px solid #353b38;border-radius:8px;padding:11px;background:#111313}.v13-tab-list article>span{width:31px;height:31px;border-radius:7px;display:grid;place-items:center;background:#142c23;color:var(--accent)}.v13-tab-list article strong,.v13-tab-list article p,.v13-tab-list article small{display:block}.v13-tab-list article p{margin:4px 0;color:#b5c0bc;line-height:1.45}.v13-tab-list article small{color:#778681}.v13-tab-empty{min-height:108px;border:1px solid #363b39;border-radius:9px;display:grid;place-items:center;color:#8d9995;background:#111313}.v13-replay-row .btn{align-self:center}.v12-player-right{display:flex;flex-direction:column}.v12-player-actions{margin-top:auto;padding-top:14px}.v12-player-tabs button{cursor:pointer}

@media(max-width:1200px){.v13-console-layout{height:auto!important;min-height:560px!important}.v11-online{display:none!important}.v12-map-shell{height:min(680px,calc(100vh - 135px))!important}}
@media(max-width:760px){.v13-boot-brand strong{font-size:25px}.v13-boot-brand img{width:54px;height:54px}.v13-boot-status{font-size:6px}.v12-map-shell{height:620px!important}}

/* V13 card separation follow-up */
.v11-wide-card+.v11-wide-card,.v11-table-card+.v11-table-card,.v11-entity-list+.v11-wide-card,.v11-wide-card+.v11-table-card,.v11-table-card+.v11-wide-card{margin-top:18px!important}.v11-entity-list>.v11-toggle-row+h3,.v11-wide-card>.v11-toggle-row+h3{margin-top:22px!important}.v11-entity-list>h3+textarea,.v11-wide-card>h3+textarea{margin-top:12px!important}.v11-table-card tbody tr,.ref-table tbody tr.detail-row,.logbook-entry,.backup-row-ref,.cdn-file-card,.stream-card{cursor:pointer}
