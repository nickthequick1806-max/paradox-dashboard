/* v10 specialized workflow modals */
.section-modal{display:grid;gap:12px}.section-modal-hero{display:grid;grid-template-columns:50px 1fr;gap:12px;align-items:center;padding:13px;border:1px solid #2b443b;background:linear-gradient(135deg,rgba(var(--accent-rgb),.075),#08120f);border-radius:12px}.section-modal-icon{width:50px;height:50px;border-radius:12px;display:grid;place-items:center;background:rgba(var(--accent-rgb),.11);border:1px solid rgba(var(--accent-rgb),.18);color:var(--accent);font-size:18px}.section-modal-hero span{color:var(--accent);font-size:7px;letter-spacing:.12em;font-weight:900}.section-modal-hero h2{margin:3px 0;font-size:15px}.section-modal-hero p{margin:0;color:#7d9089;font-size:8px}.sm-kv{padding:8px 9px;border:1px solid #20352d;border-radius:8px;background:#07100d}.sm-kv span{display:block;color:#637971;font-size:7px;text-transform:uppercase;letter-spacing:.05em}.sm-kv strong{display:block;margin-top:4px;font-size:8.5px;color:#d6e2de;overflow:hidden;text-overflow:ellipsis}.sm-tabs{display:flex;border-bottom:1px solid #264138}.sm-tabs button{padding:9px 11px;border:0;background:transparent;color:#80928b;font-size:8px}.sm-tabs button.active{color:var(--accent);border-bottom:2px solid var(--accent)}.sm-grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.log-modal-grid{display:grid;grid-template-columns:1.35fr .8fr;gap:10px}.log-modal-grid>section,.log-modal-grid>aside{border:1px solid #223a31;border-radius:10px;background:#07100d;padding:11px}.log-modal-grid aside{display:grid;gap:6px}.timeline-pro{display:grid;grid-template-columns:10px 1fr;gap:6px 8px;align-items:center}.timeline-pro i{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(var(--accent-rgb),.3)}.timeline-pro strong,.timeline-pro span{display:block}.timeline-pro strong{font-size:8.5px}.timeline-pro span{font-size:7px;color:#687c75}.sm-code{margin:0;padding:11px;border:1px solid #1c332a;border-radius:9px;background:#050b09;color:#83e8c0;font-size:8px;overflow:auto}.stre